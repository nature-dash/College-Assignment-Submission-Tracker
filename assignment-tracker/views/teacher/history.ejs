<!DOCTYPE html>
<html>
<head>
    <title>Assessment History</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body{ background:#f4f7fc; }
        .card-box{ border:none; border-radius:20px; box-shadow:0px 5px 20px rgba(0,0,0,0.1); }
        .site-footer { text-align:center; padding:16px 12px; margin-top:40px; font-size:13px; color:#8a8fa8; border-top:1px solid rgba(0,0,0,0.06); }
        @media (max-width:480px) { .site-footer { font-size:11px; padding:12px 8px; } }
        @media (max-width: 768px) {
            .table thead { display:none; }
            .table tbody tr { display:block; padding:12px; margin-bottom:10px; border-radius:14px; background:#fff; box-shadow:0px 3px 12px rgba(0,0,0,0.06); }
            .table tbody td { display:flex; justify-content:space-between; align-items:center; padding:6px 0; border:none; border-bottom:1px solid rgba(0,0,0,0.04); }
            .table tbody td:last-child { border-bottom:none; }
            .table tbody td::before { content:attr(data-label); font-size:11px; text-transform:uppercase; letter-spacing:0.5px; color:#8a8fa8; font-weight:600; }
            .searchable-select { width:100%; }
        }
    </style>
</head>
<body>

<div class="container mt-5">
    <div class="d-flex justify-content-between mb-4">
        <h2>Assessment History</h2>
        <div>
            <a href="<%= ref ? '/teacher?' + ref : '/teacher' %>" class="btn btn-secondary me-2">Back to Dashboard</a>
        </div>
    </div>

    <div class="card card-box p-4 mb-4">
        <h4 class="mb-3">Filters</h4>
        <form action="/teacher/history" method="GET">
            <input type="hidden" name="ref" value="<%= ref %>">
            <div class="row">
                <div class="col-md-3">
                    <select class="form-select" name="department">
                        <option value="">All Departments</option>
                        <% if (config && config.departments) { %>
                            <% config.departments.forEach(function(d) { %>
                                <option value="<%= d %>" <%= filters.department === d ? 'selected' : '' %>><%= d %></option>
                            <% }); %>
                        <% } %>
                    </select>
                </div>
                <div class="col-md-3">
                    <select class="form-select" name="level">
                        <option value="">All Levels</option>
                        <% if (config && config.levels) { %>
                            <% config.levels.forEach(function(l) { %>
                                <option value="<%= l %>" <%= filters.level === l ? 'selected' : '' %>><%= l %></option>
                            <% }); %>
                        <% } %>
                    </select>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary w-100">Filter</button>
                </div>
            </div>
        </form>
    </div>

    <div class="card card-box p-4">
        <p class="text-muted mb-2">Showing <%= history.length %> archived record(s)</p>
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>Assignment</th>
                        <th>Subject</th>
                        <th>Due Date</th>
                        <th>Student</th>
                        <th>Department</th>
                        <th>Level</th>
                        <th>Submission Link</th>
                        <th>Submitted At</th>
                        <th>Checked</th>
                        <th>Archived At</th>
                    </tr>
                </thead>
                <tbody>
                    <% if(history.length === 0) { %>
                        <tr><td colspan="10" class="text-center text-muted">No archived assessments found.</td></tr>
                    <% } else { %>
                        <% history.forEach(function(h) { %>
                        <tr>
                            <td data-label="Assignment"><%= h.assignmentTitle %></td>
                            <td data-label="Subject"><%= h.assignmentSubject %></td>
                            <td data-label="Due Date"><%= new Date(h.assignmentDueDate).toLocaleDateString() %></td>
                            <td data-label="Student"><%= h.studentName %><br><small class="text-muted"><%= h.studentUsername %></small></td>
                            <td data-label="Department"><%= h.studentDepartment %></td>
                            <td data-label="Level"><span class="badge bg-info"><%= h.studentLevel %></span></td>
                            <td data-label="Submission Link">
                                <% if(h.submissionLink) { %>
                                    <a href="<%= h.submissionLink %>" target="_blank" class="btn btn-sm btn-info text-white">View Link</a>
                                <% } else { %>
                                    <span class="text-muted">Not Submitted</span>
                                <% } %>
                            </td>
                            <td data-label="Submitted At"><% if(h.submittedAt) { %><%= new Date(h.submittedAt).toLocaleString() %><% } else { %><span class="text-muted">Not Submitted</span><% } %></td>
                            <td data-label="Checked">
                                <% if(!h.submittedAt) { %>
                                    <span class="text-muted">-</span>
                                <% } else if(h.checked) { %>
                                    <span class="badge bg-success">Checked</span>
                                <% } else { %>
                                    <span class="badge bg-secondary">Not Checked</span>
                                <% } %>
                            </td>
                            <td data-label="Archived At"><%= new Date(h.archivedAt).toLocaleDateString() %></td>
                        </tr>
                        <% }); %>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<footer class="site-footer">&copy; 2026 &#9670; Prince Shri Venkateshwara Arts and Science College &#9670; All rights reserved.</footer>
</body>
</html>
