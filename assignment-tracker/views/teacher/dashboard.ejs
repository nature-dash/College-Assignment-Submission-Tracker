<!DOCTYPE html>
<html>
<head>
    <title>Teacher Dashboard</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body{ background:#f4f7fc; }
        .card-box{ border:none; border-radius:20px; box-shadow:0px 5px 20px rgba(0,0,0,0.1); }
        .top-btn{ border-radius:15px; }
        .stat-card { text-decoration: none; color: inherit; display: block; }
        .stat-card:hover { transform: translateY(-5px); transition: 0.3s; }
        .searchable-select { position:relative; width:100%; }
        .searchable-select .form-select { cursor:pointer; text-align:left; }
        .searchable-menu {
            display:none; position:absolute; top:100%; left:0; right:0; z-index:1000;
            background:#fff; border:1px solid #dee2e6; border-radius:6px; padding:8px;
            max-height:300px; overflow-y:auto; box-shadow:0 6px 16px rgba(0,0,0,0.15);
        }
        .searchable-menu.show { display:block; }
        .searchable-menu .dropdown-item { cursor:pointer; border-radius:4px; }
        .searchable-menu .dropdown-item:hover { background:#f0f0f0; }
        .searchable-menu .dropdown-item.active { background:#0d6efd; color:#fff; }


        @media (max-width: 768px) {
            .container { padding-left:12px; padding-right:12px; }
            .d-flex.mb-4 { flex-direction:column; gap:10px; }
            .d-flex.mb-4 > div:last-child { align-self:flex-end; }
            .mb-4 .btn { display:inline-block; margin-bottom:6px; }
            .table thead { display:none; }
            .table tbody tr { display:block; padding:12px; margin-bottom:10px; border-radius:14px; background:#fff; box-shadow:0px 3px 12px rgba(0,0,0,0.06); }

            .table tbody td { display:flex; justify-content:space-between; align-items:center; padding:6px 0; border:none; border-bottom:1px solid rgba(0,0,0,0.04); }
            .table tbody td:last-child { border-bottom:none; }
            .table tbody td::before { content:attr(data-label); font-size:11px; text-transform:uppercase; letter-spacing:0.5px; color:#8a8fa8; font-weight:600; }
            .table tbody td:first-child { border-radius:14px 14px 0 0; }
            .table tbody td:last-child { border-radius:0 0 14px 14px; }
            .card-box.p-4 { padding:16px !important; }
            .row.mb-4 .col-md-3 { margin-bottom:10px; }
            .row .col-md-2, .row .col-md-3, .row .col-md-4 { margin-bottom:8px; }
            .d-flex.justify-content-between.align-items-center { flex-direction:column; gap:8px; align-items:flex-start !important; }
        }
    </style>
</head>
<body>

<div class="container mt-5">

    <div class="d-flex justify-content-between mb-4">
        <div>
            <h2>Teacher Dashboard</h2>
            <p>Welcome, <b><%= user.name || user.username %></b></p>
        </div>
        <div style="display:flex;flex-direction:column;align-items:flex-end;gap:8px;">
            <a href="/logout" class="btn btn-danger top-btn">Logout</a>
        </div>
    </div>

    <% const dashQuery = Object.keys(filters).filter(k => k !== 'taskStatus').map(k => k + '=' + encodeURIComponent(filters[k])).join('&'); %>
    <% const taskQuery = Object.keys(filters).map(k => k + '=' + encodeURIComponent(filters[k])).join('&'); %>

    <div class="row mb-4">
        <div class="col-md-3">
            <a href="/teacher<%= dashQuery ? '?' + dashQuery : '' %>" class="stat-card">
                <div class="card card-box text-center p-4">
                    <h5>Total Tasks</h5>
                    <h1><%= totalTasks %></h1>
                </div>
            </a>
        </div>
        <div class="col-md-3">
            <a href="/teacher?taskStatus=Submitted<%= dashQuery ? '&' + dashQuery : '' %>" class="stat-card">
                <div class="card card-box text-center p-4">
                    <h5>Submitted</h5>
                    <h1 class="text-success"><%= submittedCount %></h1>
                </div>
            </a>
        </div>
        <div class="col-md-3">
            <a href="/teacher?taskStatus=Pending<%= dashQuery ? '&' + dashQuery : '' %>" class="stat-card">
                <div class="card card-box text-center p-4">
                    <h5>Pending</h5>
                    <h1 class="text-warning"><%= pendingCount %></h1>
                </div>
            </a>
        </div>
        <div class="col-md-3">
            <a href="/teacher?taskStatus=Late<%= dashQuery ? '&' + dashQuery : '' %>" class="stat-card">
                <div class="card card-box text-center p-4">
                    <h5>Late</h5>
                    <h1 class="text-danger"><%= lateCount %></h1>
                </div>
            </a>
        </div>
    </div>

    <!-- Buttons ABOVE the filter bar -->
    <div class="mb-4">
        <a href="/teacher/add" class="btn btn-success me-2">+ Add Assignment</a>
        <a href="/teacher/calendar<%= dashQuery ? '?ref=' + encodeURIComponent(dashQuery) : '' %>" class="btn btn-primary me-2">Assignment Calendar</a>
        <a href="/teacher/students<%= dashQuery ? '?ref=' + encodeURIComponent(dashQuery) : '' %>" class="btn btn-info text-white">Students List</a>
    </div>

    <% if (!displayTasks) { %>
    <!-- Default Assignments View -->
    <div class="card card-box p-4 mb-4">
        <h4 class="mb-3">Filters</h4>
        <form action="/teacher" method="GET">
            <% Object.keys(filters).forEach(function(key) { %>
                <% if (key !== 'department' && key !== 'level' && key !== 'year' && key !== 'subject') { %>
                    <input type="hidden" name="<%= key %>" value="<%= filters[key] %>">
                <% } %>
            <% }); %>
            <div class="row">
                <div class="col-md-3">
                    <div class="searchable-select">
                        <button class="form-select dropdown-toggle" type="button" onclick="searchableToggle(this)">
                            <%= filters.department || 'All Departments' %>
                        </button>
                        <div class="searchable-menu">
                            <input type="text" class="form-control form-control-sm mb-2" placeholder="Search..." oninput="searchableFilter(this)" onclick="event.stopPropagation()">
                            <button type="button" class="dropdown-item" data-value="" onclick="searchablePick(this)">All Departments</button>
                            <% (config.departments || []).forEach(function(d) { %>
                                <button type="button" class="dropdown-item<%= filters.department === d ? ' active' : '' %>" data-value="<%= d %>" onclick="searchablePick(this)"><%= d %></button>
                            <% }); %>
                        </div>
                        <input type="hidden" name="department" value="<%= filters.department || '' %>">
                    </div>
                </div>
                <div class="col-md-2">
                    <select class="form-select" name="level">
                        <option value="">All Levels</option>
                        <option value="UG" <%= filters.level === 'UG' ? 'selected' : '' %>>UG</option>
                        <option value="PG" <%= filters.level === 'PG' ? 'selected' : '' %>>PG</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <div class="searchable-select">
                        <button class="form-select dropdown-toggle" type="button" onclick="searchableToggle(this)">
                            <%= filters.year ? 'Year ' + filters.year : 'All Years' %>
                        </button>
                        <div class="searchable-menu">
                            <input type="text" class="form-control form-control-sm mb-2" placeholder="Search..." oninput="searchableFilter(this)" onclick="event.stopPropagation()">
                            <button type="button" class="dropdown-item" data-value="" onclick="searchablePick(this)">All Years</button>
                            <% const yrOpts = [...new Set((config.years || []).map(y => y.year))].sort(); %>
                            <% yrOpts.forEach(function(y) { %>
                                <button type="button" class="dropdown-item<%= filters.year == y ? ' active' : '' %>" data-value="<%= y %>" onclick="searchablePick(this)">Year <%= y %></button>
                            <% }); %>
                        </div>
                        <input type="hidden" name="year" value="<%= filters.year || '' %>">
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="searchable-select">
                        <button class="form-select dropdown-toggle" type="button" onclick="searchableToggle(this)">
                            <%= filters.subject || 'All Subjects' %>
                        </button>
                        <div class="searchable-menu">
                            <input type="text" class="form-control form-control-sm mb-2" placeholder="Search..." oninput="searchableFilter(this)" onclick="event.stopPropagation()">
                            <button type="button" class="dropdown-item" data-value="" onclick="searchablePick(this)">All Subjects</button>
                            <% (allSubjects || []).forEach(function(s) { %>
                                <button type="button" class="dropdown-item<%= filters.subject === s ? ' active' : '' %>" data-value="<%= s %>" onclick="searchablePick(this)"><%= s %></button>
                            <% }); %>
                        </div>
                        <input type="hidden" name="subject" value="<%= filters.subject || '' %>">
                    </div>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary w-100">Filter</button>
                </div>
            </div>
        </form>
    </div>

    <div class="card card-box p-4">
        <h4>Assignments</h4>
        <p class="text-muted mb-2">Showing <%= assignments.length %> assignment(s)</p>
        <table class="table table-hover mt-2">
            <thead>
                <tr>
                    <th>Title</th>
                    <th>Department</th>
                    <th>Degree Level</th>
                    <th>Year</th>
                    <th>Subject</th>
                    <th>Due Date</th>
                    <th>Progress</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                <% if(assignments.length === 0) { %>
                    <tr><td colspan="8" class="text-center text-muted">No assignments found</td></tr>
                <% } else { %>
                    <% assignments.forEach(function(a) { %>
                    <tr>
                        <td data-label="Title">
                            <a href="/teacher/view/<%= a.id %><%= dashQuery ? '?ref=' + encodeURIComponent(dashQuery) : '' %>"><%= a.title %></a>
                            <br><small class="text-muted">Assigned by: <%= a.assignedBy || 'Admin' %></small>
                        </td>
                        <td data-label="Department"><%= a.department %></td>
                        <td data-label="Degree Level"><%= a.level || 'UG' %></td>
                        <td data-label="Year"><%= a.year %></td>
                        <td data-label="Subject"><%= a.subject %></td>
                        <td data-label="Due Date"><%= new Date(a.dueDate).toLocaleDateString() %></td>
                        <td data-label="Progress">
                            <% if(a.totalStudents === 0) { %>
                                <span class="badge bg-secondary">No Students</span>
                            <% } else { %>
                                <span class="badge <%= a.submittedStudents === a.totalStudents ? 'bg-success' : (a.submittedStudents > 0 ? 'bg-warning' : 'bg-danger') %>">
                                    <%= a.submittedStudents %>/<%= a.totalStudents %> submitted
                                </span>
                            <% } %>
                        </td>
                        <td data-label="Action">
                            <a href="/teacher/edit/<%= a.id %><%= dashQuery ? '?ref=' + encodeURIComponent(dashQuery) : '' %>" class="btn btn-sm btn-primary">Edit</a>
                        </td>
                    </tr>
                    <% }); %>
                <% } %>
            </tbody>
        </table>
    </div>

    <% } else { %>
    
    <!-- Task View -->
    <div class="mb-4 d-flex justify-content-between align-items-center">
        <h4>Showing <%= filters.taskStatus %> Tasks (<%= displayTasks.length %>)</h4>
        <a href="/teacher<%= dashQuery ? '?' + dashQuery : '' %>" class="btn btn-secondary">Back to Assignments</a>
    </div>

    <!-- Filters for Task View -->
    <div class="card card-box p-4 mb-4">
        <h4 class="mb-3">Filters</h4>
        <form action="/teacher" method="GET">
            <input type="hidden" name="taskStatus" value="<%= filters.taskStatus %>">
            <% Object.keys(filters).forEach(function(key) { %>
                <% if (key !== 'department' && key !== 'level' && key !== 'year' && key !== 'subject' && key !== 'taskStatus') { %>
                    <input type="hidden" name="<%= key %>" value="<%= filters[key] %>">
                <% } %>
            <% }); %>
            <div class="row">
                <div class="col-md-3">
                    <div class="searchable-select">
                        <button class="form-select dropdown-toggle" type="button" onclick="searchableToggle(this)">
                            <%= filters.department || 'All Departments' %>
                        </button>
                        <div class="searchable-menu">
                            <input type="text" class="form-control form-control-sm mb-2" placeholder="Search..." oninput="searchableFilter(this)" onclick="event.stopPropagation()">
                            <button type="button" class="dropdown-item" data-value="" onclick="searchablePick(this)">All Departments</button>
                            <% (config.departments || []).forEach(function(d) { %>
                                <button type="button" class="dropdown-item<%= filters.department === d ? ' active' : '' %>" data-value="<%= d %>" onclick="searchablePick(this)"><%= d %></button>
                            <% }); %>
                        </div>
                        <input type="hidden" name="department" value="<%= filters.department || '' %>">
                    </div>
                </div>
                <div class="col-md-2">
                    <select class="form-select" name="level">
                        <option value="">All Levels</option>
                        <option value="UG" <%= filters.level === 'UG' ? 'selected' : '' %>>UG</option>
                        <option value="PG" <%= filters.level === 'PG' ? 'selected' : '' %>>PG</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <div class="searchable-select">
                        <button class="form-select dropdown-toggle" type="button" onclick="searchableToggle(this)">
                            <%= filters.year ? 'Year ' + filters.year : 'All Years' %>
                        </button>
                        <div class="searchable-menu">
                            <input type="text" class="form-control form-control-sm mb-2" placeholder="Search..." oninput="searchableFilter(this)" onclick="event.stopPropagation()">
                            <button type="button" class="dropdown-item" data-value="" onclick="searchablePick(this)">All Years</button>
                            <% const yrOpts = [...new Set((config.years || []).map(y => y.year))].sort(); %>
                            <% yrOpts.forEach(function(y) { %>
                                <button type="button" class="dropdown-item<%= filters.year == y ? ' active' : '' %>" data-value="<%= y %>" onclick="searchablePick(this)">Year <%= y %></button>
                            <% }); %>
                        </div>
                        <input type="hidden" name="year" value="<%= filters.year || '' %>">
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="searchable-select">
                        <button class="form-select dropdown-toggle" type="button" onclick="searchableToggle(this)">
                            <%= filters.subject || 'All Subjects' %>
                        </button>
                        <div class="searchable-menu">
                            <input type="text" class="form-control form-control-sm mb-2" placeholder="Search..." oninput="searchableFilter(this)" onclick="event.stopPropagation()">
                            <button type="button" class="dropdown-item" data-value="" onclick="searchablePick(this)">All Subjects</button>
                            <% (allSubjects || []).forEach(function(s) { %>
                                <button type="button" class="dropdown-item<%= filters.subject === s ? ' active' : '' %>" data-value="<%= s %>" onclick="searchablePick(this)"><%= s %></button>
                            <% }); %>
                        </div>
                        <input type="hidden" name="subject" value="<%= filters.subject || '' %>">
                    </div>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary w-100">Filter</button>
                </div>
            </div>
        </form>
    </div>

    <div class="card card-box p-4">
        <p class="text-muted mb-2">Showing <%= displayTasks.length %> task(s)</p>
        <table class="table table-hover mt-2">
            <thead>
                <tr>
                    <th>Student Name</th>
                    <th>Assignment Title</th>
                    <th>Department</th>
                    <th>Due Date</th>
                    <th>Status</th>
                    <th>Submission Link</th>
                    <% if(filters.taskStatus === 'Submitted') { %>
                    <th>Checked</th>
                    <% } %>
                </tr>
            </thead>
            <tbody>
                <% if(displayTasks.length === 0) { %>
                    <tr><td colspan="7" class="text-center text-muted">No tasks found for this status.</td></tr>
                <% } else { %>
                    <% displayTasks.forEach(function(t) { 
                        const currentQuery = Object.keys(filters).map(k => k + '=' + encodeURIComponent(filters[k])).join('&');
                    %>
                    <tr>
                        <td data-label="Student Name"><a href="/teacher/student/<%= t.student.id %>?ref=<%= encodeURIComponent(currentQuery) %>"><%= t.student.name %></a></td>
                        <td data-label="Assignment"><a href="/teacher/view/<%= t.assignment.id %>?ref=<%= encodeURIComponent(currentQuery) %>"><%= t.assignment.title %></a></td>
                        <td data-label="Department"><%= t.assignment.department %></td>
                        <td data-label="Due Date"><%= new Date(t.assignment.dueDate).toLocaleDateString() %></td>
                        <td data-label="Status">
                            <% if(t.status === 'Submitted') { %>
                                <span class="badge bg-success">Submitted</span>
                            <% } else if(t.status === 'Pending') { %>
                                <span class="badge bg-warning">Pending</span>
                            <% } else if(t.status === 'Late') { %>
                                <span class="badge bg-danger">Late</span>
                            <% } %>
                        </td>
                        <td data-label="Submission">
                            <% if(t.submission && t.submission.link) { %>
                                <a href="<%= t.submission.link %>" target="_blank" class="btn btn-sm btn-info text-white">View Link</a>
                            <% } else { %>
                                -
                            <% } %>
                        </td>
                        <% if(filters.taskStatus === 'Submitted') { %>
                        <td data-label="Checked">
                            <form action="/teacher/check/<%= t.assignment.id %>/<%= t.student.id %>" method="POST" style="display:inline;">
                                <input type="hidden" name="ref" value="<%= currentQuery %>">
                                <% if(t.submission && t.submission.checked) { %>
                                    <button class="btn btn-sm btn-success">Checked</button>
                                <% } else { %>
                                    <button class="btn btn-sm btn-outline-secondary">Not Checked</button>
                                <% } %>
                            </form>
                        </td>
                        <% } %>
                    </tr>
                    <% }); %>
                <% } %>
            </tbody>
        </table>
    </div>
    
    <% } %>

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>


function searchableToggle(btn) {
    var menu = btn.nextElementSibling;
    var isOpen = menu.classList.contains('show');
    document.querySelectorAll('.searchable-menu.show').forEach(function(m) { if (m !== menu) m.classList.remove('show'); });
    menu.classList.toggle('show');
    if (!isOpen) { menu.querySelector('input').value = ''; menu.querySelector('input').focus(); menu.querySelectorAll('.dropdown-item').forEach(function(it) { it.style.display = ''; }); }
}
function searchableFilter(inp) {
    var val = inp.value.toLowerCase();
    inp.parentNode.querySelectorAll('.dropdown-item').forEach(function(it) { it.style.display = it.textContent.toLowerCase().indexOf(val) > -1 ? '' : 'none'; });
}
function searchablePick(item) {
    var menu = item.closest('.searchable-menu');
    var container = menu.closest('.searchable-select');
    var btn = container.querySelector('.dropdown-toggle');
    var hidden = container.querySelector('input[type="hidden"]');
    btn.textContent = item.textContent;
    hidden.value = item.getAttribute('data-value') || '';
    menu.querySelectorAll('.dropdown-item').forEach(function(it) { it.classList.remove('active'); });
    item.classList.add('active');
    menu.classList.remove('show');
    var form = container.closest('form');
    if (form) form.submit();
}
document.addEventListener('click', function(e) { if (!e.target.closest('.searchable-select')) { document.querySelectorAll('.searchable-menu.show').forEach(function(m) { m.classList.remove('show'); }); } });
</script>
</body>
</html>