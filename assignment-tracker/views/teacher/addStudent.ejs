<!DOCTYPE html>
<html>
<head>
    <title>Add Student</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        .site-footer { text-align:center; padding:16px 12px; margin-top:40px; font-size:13px; color:#8a8fa8; border-top:1px solid rgba(0,0,0,0.06); }
        @media (max-width:480px) { .site-footer { font-size:11px; padding:12px 8px; } }
    </style>
</head>
<body class="bg-light">


<div class="container mt-5">
    <div class="card shadow p-4 mx-auto" style="max-width: 600px;">
        <h2>Add New Student</h2>
        
        <form method="POST" action="/teacher/students/add">
            
            <div class="mb-3">
                <label>Registration Number (Username)</label>
                <input class="form-control" name="username" required>
            </div>
            
            <div class="mb-3">
                <label>Full Name</label>
                <input class="form-control" name="name" required>
            </div>

            <div class="mb-3">
                <label>Password</label>
                <input type="password" class="form-control" name="password" required>
            </div>

            <div class="mb-3">
                <label>Department</label>
                <select class="form-select" name="department">
                    <option>B.Sc Computer Science</option>
                    <option>BCA</option>
                    <option>B.Com</option>
                    <option>BBA</option>
                    <option>B.Sc Mathematics</option>
                </select>
            </div>

            <div class="mb-3">
                <label>Year</label>
                <select class="form-select" name="year">
                    <option value="1">I Year</option>
                    <option value="2">II Year</option>
                    <option value="3">III Year</option>
                </select>
            </div>

            <button class="btn btn-success">Save Student</button>
            <a href="/teacher/students" class="btn btn-secondary">Cancel</a>
            
        </form>
    </div>
</div>

<footer class="site-footer">&copy; 2026 &#9670; Prince Shri Venkateshwara Arts and Science College &#9670; All rights reserved.</footer>
</body>
</html>
