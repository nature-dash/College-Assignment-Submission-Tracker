<!DOCTYPE html>
<html>
<head>
    <title>Student Details</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body{ background:#f4f7fc; }
        .card-box{ border:none; border-radius:20px; box-shadow:0px 5px 20px rgba(0,0,0,0.1); }
        .site-footer { text-align:center; padding:16px 12px; margin-top:40px; font-size:13px; color:#8a8fa8; border-top:1px solid rgba(0,0,0,0.06); }
        @media (max-width:480px) { .site-footer { font-size:11px; padding:12px 8px; } }
    </style>
</head>
<body>


<div class="container mt-5">
    <div class="d-flex justify-content-between mb-4">
        <h2><%= student.name %> (<%= student.username %>)</h2>
        <% if(ref) { %>
            <a href="/teacher?<%= ref %>" class="btn btn-secondary">Back</a>
        <% } else { %>
            <a href="/teacher/students" class="btn btn-secondary">Back to Students</a>
        <% } %>
    </div>

    <div class="card card-box p-4 mb-4">
        <h4>Student Profile</h4>
        <p><strong>Degree Level:</strong> <%= student.level || 'UG' %></p>
        <p><strong>Department:</strong> <%= student.department %></p>
        <p><strong>Year:</strong> <%= student.year %></p>
        <p><strong>Semester:</strong> <%= student.semester || '-' %></p>
    </div>

    <div class="card card-box p-4">
        <h4>Assigned Tasks & Statuses</h4>
        
        <table class="table table-hover mt-3">
            <thead>
                <tr>
                    <th>Title</th>
                    <th>Subject</th>
                    <th>Due Date</th>
                    <th>Status</th>
                    <th>Submission Link</th>
                    <th>Submitted On</th>
                    <th>Checked by Teacher</th>
                </tr>
            </thead>
            <tbody>
                <% if(assignments.length === 0) { %>
                    <tr><td colspan="7" class="text-center text-muted">No assignments found for this student.</td></tr>
                <% } else { %>
                    <% assignments.forEach(function(a) { %>
                    <tr>
                        <td><a href="/teacher/view/<%= a.id %>"><%= a.title %></a></td>
                        <td><%= a.subject %></td>
                        <td><%= new Date(a.dueDate).toLocaleDateString() %></td>
                        <td>
                            <% if(a.status === 'Submitted') { %>
                                <span class="badge bg-success">Submitted <%= a.isLate ? '(Late)' : '' %></span>
                            <% } else if(a.status === 'Pending') { %>
                                <span class="badge bg-warning">Pending</span>
                            <% } else if(a.status === 'Late') { %>
                                <span class="badge bg-danger">Late</span>
                            <% } %>
                        </td>
                        <td>
                            <% if(a.status === 'Submitted' && a.submission && a.submission.link) { %>
                                <a href="<%= a.submission.link %>" target="_blank" class="btn btn-sm btn-info text-white">View Link</a>
                            <% } else { %>
                                -
                            <% } %>
                        </td>
                        <td>
                            <%= a.submittedAt ? new Date(a.submittedAt).toLocaleString() : '-' %>
                        </td>
                        <td>
                            <% if(a.submission) { %>
                                <input type="checkbox" <%= a.submission.checked ? 'checked' : '' %> onchange="
                                    var f = document.createElement('form');
                                    f.method = 'POST';
                                    f.action = '/teacher/check/<%= a.id %>/<%= student.id %>';
                                    var i = document.createElement('input');
                                    i.type = 'hidden';
                                    i.name = 'checked';
                                    i.value = this.checked;
                                    f.appendChild(i);
                                    <% if(ref) { %>
                                    var r = document.createElement('input');
                                    r.type = 'hidden';
                                    r.name = 'ref';
                                    r.value = '<%= ref %>';
                                    f.appendChild(r);
                                    <% } %>
                                    document.body.appendChild(f);
                                    f.submit();
                                ">
                            <% } else { %>
                                -
                            <% } %>
                        </td>
                    </tr>
                    <% }); %>
                <% } %>
            </tbody>
        </table>
    </div>
</div>

<footer class="site-footer">&copy; 2026 &#9670; Prince Shri Venkateshwara Arts and Science College &#9670; All rights reserved.</footer>
</body>
</html>
