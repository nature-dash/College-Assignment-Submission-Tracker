<!DOCTYPE html>
<html>
<head>
    <title>Add Assignment</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet">
</head>

<body class="bg-light">

<div class="container mt-5">

<div class="card shadow p-4">

<h2>Add Assignment</h2>

<form
method="POST"
action="/teacher/add">

<div class="mb-3">

<label>Title</label>

<input
class="form-control"
name="title"
required>

</div>

<div class="mb-3">

<label>Department</label>

<select
class="form-select"
name="department">

<option>B.Sc Computer Science</option>
<option>BCA</option>
<option>B.Com</option>
<option>BBA</option>

</select>

</div>

<div class="mb-3">

<label>Year</label>

<select
class="form-select"
name="year">

<option value="1">I Year</option>
<option value="2">II Year</option>
<option value="3">III Year</option>

</select>

</div>

<div class="mb-3">

<label>Subject</label>

<input
class="form-control"
name="subject"
required>

</div>

<div class="mb-3">

<label>Due Date</label>

<input
type="date"
class="form-control"
name="dueDate"
required>

</div>

<button
class="btn btn-success">
Save
</button>

<a
href="/teacher"
class="btn btn-secondary">
Cancel
</a>

</form>

</div>

</div>

</body>
</html>