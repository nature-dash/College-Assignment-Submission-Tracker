<!DOCTYPE html>
<html>
<head>
    <title>Add Assignment</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet">
    <style>
        .site-footer { text-align:center; padding:16px 12px; margin-top:40px; font-size:13px; color:#8a8fa8; border-top:1px solid rgba(0,0,0,0.06); }
        @media (max-width:480px) { .site-footer { font-size:11px; padding:12px 8px; } }
    </style>
</head>

<body class="bg-light">


<div class="container mt-5">

<div class="card shadow p-4">

<h2>Add Assignment</h2>

<form
method="POST"
action="/teacher/add">

<div class="mb-3">

<label>Title</label>

<input
class="form-control"
name="title"
required>

</div>

<div class="mb-3">

<label>Department</label>

<select
class="form-select"
name="department">

<% if (config && config.departments) { %>
  <% config.departments.forEach(function(d) { %>
    <option><%= d %></option>
  <% }); %>
<% } else { %>
  <option>BCA</option>
<% } %>

</select>

</div>

<div class="mb-3">

<label>Degree Level</label>

<select
class="form-select"
name="level">

<option value="UG">UG</option>
<option value="PG">PG</option>

</select>

</div>

<div class="mb-3">

<label>Year</label>

<select
class="form-select"
name="year">

<option value="1">I Year</option>
<option value="2">II Year</option>
<option value="3">III Year</option>

</select>

</div>

<div class="mb-3">

<label>Subject</label>

<input
class="form-control"
name="subject"
required>

</div>

<div class="mb-3">

<label>Due Date</label>

<input
type="date"
class="form-control"
name="dueDate"
required>

</div>

<button
class="btn btn-success">
Save
</button>

<a
href="/teacher"
class="btn btn-secondary">
Cancel
</a>

</form>

</div>

</div>

<footer class="site-footer">&copy; 2026 &#9670; Prince Shri Venkateshwara Arts and Science College &#9670; All rights reserved.</footer>
</body>
</html>