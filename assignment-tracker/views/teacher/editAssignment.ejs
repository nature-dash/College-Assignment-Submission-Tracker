<!DOCTYPE html>
<html>
<head>
    <title>Edit Assignment</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        .site-footer { text-align:center; padding:16px 12px; margin-top:40px; font-size:13px; color:#8a8fa8; border-top:1px solid rgba(0,0,0,0.06); }
        @media (max-width:480px) { .site-footer { font-size:11px; padding:12px 8px; } }
    </style>
</head>
<body class="bg-light">


<div class="container mt-5">
    <div class="card shadow p-4 mx-auto" style="max-width: 600px;">
        <h2>Edit Assignment</h2>
        
        <form method="POST" action="/teacher/edit/<%= assignment.id %>">
            
            <div class="mb-3">
                <label>Title</label>
                <input class="form-control" name="title" value="<%= assignment.title %>" required>
            </div>
            
            <div class="mb-3">
                <label>Department</label>
                <select class="form-select" name="department">
                    <option <%= assignment.department === 'B.Sc Computer Science' ? 'selected' : '' %>>B.Sc Computer Science</option>
                    <option <%= assignment.department === 'BCA' ? 'selected' : '' %>>BCA</option>
                    <option <%= assignment.department === 'B.Com' ? 'selected' : '' %>>B.Com</option>
                    <option <%= assignment.department === 'BBA' ? 'selected' : '' %>>BBA</option>
                </select>
            </div>

            <div class="mb-3">
                <label>Degree Level</label>
                <select class="form-select" name="level">
                    <option value="UG" <%= (assignment.level || 'UG') === 'UG' ? 'selected' : '' %>>UG</option>
                    <option value="PG" <%= (assignment.level || 'UG') === 'PG' ? 'selected' : '' %>>PG</option>
                </select>
            </div>

            <div class="mb-3">
                <label>Year</label>
                <select class="form-select" name="year">
                    <option value="1" <%= assignment.year == 1 ? 'selected' : '' %>>I Year</option>
                    <option value="2" <%= assignment.year == 2 ? 'selected' : '' %>>II Year</option>
                    <option value="3" <%= assignment.year == 3 ? 'selected' : '' %>>III Year</option>
                </select>
            </div>

            <div class="mb-3">
                <label>Subject</label>
                <input class="form-control" name="subject" value="<%= assignment.subject %>" required>
            </div>

            <div class="mb-3">
                <label>Due Date</label>
                <input type="date" class="form-control" name="dueDate" value="<%= assignment.dueDate %>" required>
            </div>

            <button class="btn btn-primary">Update</button>
            <a href="<%= ref ? '/teacher?' + ref : '/teacher' %>" class="btn btn-secondary">Cancel</a>
            
        </form>
    </div>
</div>

<footer class="site-footer">&copy; 2026 &#9670; Prince Shri Venkateshwara Arts and Science College &#9670; All rights reserved.</footer>
</body>
</html>
