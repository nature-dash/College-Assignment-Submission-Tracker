<!DOCTYPE html>
<html>
<head>
<title>Student Dashboard</title>
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<style>
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');
  * { margin:0; padding:0; box-sizing:border-box; }

  :root {
    --bg: linear-gradient(135deg, #f0f4ff 0%, #e8ecf8 100%);
    --text: #1a1c2e;
    --text-muted: #8a8fa8;
    --card-bg: #fff;
    --card-border: #e2e4ed;
    --table-row: #f8f9fd;
    --table-row-hover: #f0f2f8;
    --td-color: #4a4e6b;
    --th-color: #8a8fa8;
    --form-bg: #f5f6fa;
    --form-border: #e2e4ed;
    --form-text: #1a1c2e;
    --form-option-bg: #fff;
    --menu-bg: #fff;
    --menu-text: #4a4e6b;
    --menu-hover-bg: #f0f2f8;
    --menu-hover-text: #1a1c2e;
    --modal-bg: #fff;
    --modal-text: #1a1c2e;
    --divider: rgba(0,0,0,0.04);
    --hero-color: #1a1c2e;
    --hero-shadow: none;
    --btn-glass-bg: #fff;
    --btn-glass-text: #4a4e6b;
    --btn-glass-border: #e2e4ed;
    --btn-glass-shadow: rgba(0,0,0,0.04);
    --btn-glass-hover-bg: #f5f6fa;
    --btn-glass-hover-text: #1a1c2e;
    --btn-danger-bg: #fff0f0;
    --btn-danger-text: #d14545;
    --btn-danger-border: #ffd4d4;
    --btn-danger-hover-bg: #ffe0e0;
    --badge-late-bg: #fff0f0;
    --badge-late-text: #d14545;
    --badge-late-border: #ffd4d4;
    --badge-pending-bg: #fff8e6;
    --badge-pending-text: #e6a020;
    --badge-pending-border: #ffe8b8;
    --badge-submitted-bg: #eafaef;
    --badge-submitted-text: #2b9e4a;
    --badge-submitted-border: #c6ebd4;
    --action-view-bg: #f0f2f8;
    --action-view-text: #4a4e6b;
    --action-view-border: #e2e4ed;
    --action-view-hover-bg: #e5e7ef;
    --action-view-hover-text: #1a1c2e;
    --action-edit-bg: #e8f0fe;
    --action-edit-text: #4d96ff;
    --action-edit-border: #cde0fc;
    --action-edit-hover-bg: #d4e4fc;
    --hero-subtitle: #8a8fa8;
    --hero-subtitle-span: #4a4e6b;
    --stat-num-late: #d14545;
    --stat-num-pending: #e6a020;
    --stat-num-done: #2b9e4a;
    --stat-bg: #fff;
    --stat-border: #e2e4ed;
    --stat-hover-bg: #fff;
    --stat-hover-border: #e2e4ed;
    --mobile-td-border: rgba(0,0,0,0.04);
    --mobile-td-before: #8a8fa8;
    --close-filter: none;
    --empty-text: #8a8fa8;
    --glass-h4: #1a1c2e;
    --stat-shadow: 0 2px 8px rgba(0,0,0,0.04);
    --card-shadow: 0 2px 8px rgba(0,0,0,0.04);
    --form-label: #4a4e6b;
    --menu-border: #e2e4ed;
    --menu-shadow: rgba(0,0,0,0.1);
    --menu-input-bg: #f5f6fa;
    --menu-input-border: #e2e4ed;
    --menu-input-text: #1a1c2e;
  }

  body.dark {
    --bg: linear-gradient(135deg, #050916 0%, #0a0e27 40%, #0d1635 70%, #0a1128 100%);
    --text: #e0e4f0;
    --text-muted: #7880a0;
    --card-bg: rgba(255,255,255,0.04);
    --card-border: rgba(255,255,255,0.08);
    --table-row: rgba(255,255,255,0.04);
    --table-row-hover: rgba(255,255,255,0.08);
    --td-color: #b0b8d0;
    --th-color: #7880a0;
    --form-bg: rgba(0,0,0,0.25);
    --form-border: rgba(255,255,255,0.10);
    --form-text: #e0e4f0;
    --form-option-bg: #0a0e27;
    --menu-bg: #0d1230;
    --menu-text: #b0b8d0;
    --menu-hover-bg: rgba(255,255,255,0.08);
    --menu-hover-text: #fff;
    --modal-bg: #0d1230;
    --modal-text: #e0e4f0;
    --divider: rgba(255,255,255,0.06);
    --hero-color: #fff;
    --hero-shadow: 0 0 20px rgba(255,230,0,0.6), 0 0 40px rgba(255,200,0,0.4), 0 0 60px rgba(255,180,0,0.2);
    --btn-glass-bg: rgba(255,255,255,0.06);
    --btn-glass-text: #b0b8d0;
    --btn-glass-border: rgba(255,255,255,0.10);
    --btn-glass-shadow: rgba(0,0,0,0.2);
    --btn-glass-hover-bg: rgba(255,255,255,0.12);
    --btn-glass-hover-text: #fff;
    --btn-danger-bg: rgba(209,69,69,0.15);
    --btn-danger-text: #ff7a7a;
    --btn-danger-border: rgba(209,69,69,0.25);
    --btn-danger-hover-bg: rgba(209,69,69,0.25);
    --badge-late-bg: rgba(255,107,107,0.15);
    --badge-late-text: #ff6b6b;
    --badge-late-border: rgba(255,107,107,0.25);
    --badge-pending-bg: rgba(240,192,64,0.15);
    --badge-pending-text: #f0c040;
    --badge-pending-border: rgba(240,192,64,0.25);
    --badge-submitted-bg: rgba(76,223,122,0.15);
    --badge-submitted-text: #4cdf7a;
    --badge-submitted-border: rgba(76,223,122,0.25);
    --action-view-bg: rgba(255,255,255,0.06);
    --action-view-text: #b0b8d0;
    --action-view-border: rgba(255,255,255,0.10);
    --action-view-hover-bg: rgba(255,255,255,0.12);
    --action-view-hover-text: #fff;
    --action-edit-bg: rgba(77,150,255,0.15);
    --action-edit-text: #7ab8ff;
    --action-edit-border: rgba(77,150,255,0.25);
    --action-edit-hover-bg: rgba(77,150,255,0.25);
    --hero-subtitle: #8890aa;
    --hero-subtitle-span: #c0c8e0;
    --stat-num-late: #ff6b6b;
    --stat-num-pending: #f0c040;
    --stat-num-done: #4cdf7a;
    --stat-bg: rgba(255,255,255,0.04);
    --stat-border: rgba(255,255,255,0.08);
    --stat-hover-bg: rgba(255,255,255,0.08);
    --stat-hover-border: rgba(255,255,255,0.15);
    --mobile-td-border: rgba(255,255,255,0.06);
    --mobile-td-before: #7880a0;
    --close-filter: invert(1);
    --empty-text: #7880a0;
    --glass-h4: #e0e4f0;
    --stat-shadow: none;
    --card-shadow: none;
    --form-label: #b0b8d0;
    --menu-border: rgba(255,255,255,0.10);
    --menu-shadow: rgba(0,0,0,0.5);
    --menu-input-bg: rgba(0,0,0,0.3);
    --menu-input-border: rgba(255,255,255,0.10);
    --menu-input-text: #e0e4f0;
  }

  body {
    font-family: 'Inter', sans-serif;
    overflow-x: hidden;
    min-height: 100vh;
    background: var(--bg);
    color: var(--text);
  }

  body:not(.dark) {
    background-size: 150% 150%;
    animation: gradientShift 15s ease infinite;
  }

  @keyframes gradientShift {
    0% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
    100% { background-position: 0% 50%; }
  }

  #particleCanvas {
    position: fixed;
    top: 0; left: 0;
    width: 100vw; height: 100vh;
    z-index: 0;
    pointer-events: none;
    display: none;
  }
  body.dark #particleCanvas { display: block; }

  .content-wrap {
    position: relative;
    z-index: 1;
    min-height: 100vh;
    padding: 30px 40px 60px;
  }
  .top-bar {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 30px;
  }
  .top-bar h2 {
    font-weight: 800;
    font-size: 28px;
    background: linear-gradient(135deg, <%= tailColor %>, #4d96ff);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin: 0;
  }
  .top-bar .nav-btns { display:flex; gap:12px; flex-wrap:wrap; }
  .top-bar .nav-btns a {
    padding: 8px 20px;
    border-radius: 50px;
    font-weight: 600;
    font-size: 14px;
    text-decoration: none;
    transition: all .3s;
  }
  .top-right { display:flex; flex-direction:column; align-items:flex-end; gap:8px; }
  .theme-switcher { display:flex; gap:8px; }
  .theme-dot {
    width: 22px; height: 22px;
    border-radius: 50%;
    border: 2px solid var(--card-border);
    cursor: pointer;
    transition: all .3s;
    padding: 0;
    background: transparent;
  }
  .theme-dot.dot-light { background: #fff; }
  .theme-dot.dot-dark { background: #1a1c2e; }
  body.dark .theme-dot.dot-dark { border-color: #4d96ff; transform:scale(1.15); }
  .theme-dot.dot-light.active { border-color: #4d96ff; transform:scale(1.15); }
  .theme-dot:hover { transform:scale(1.2); }

  .btn-glass {
    background: var(--btn-glass-bg);
    color: var(--btn-glass-text);
    border: 1px solid var(--btn-glass-border);
    box-shadow: 0 2px 8px var(--btn-glass-shadow);
    backdrop-filter: blur(6px);
  }
  .btn-glass:hover {
    background: var(--btn-glass-hover-bg);
    color: var(--btn-glass-hover-text);
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(0,0,0,0.3);
  }
  .btn-glass-danger {
    background: var(--btn-danger-bg);
    color: var(--btn-danger-text);
    border: 1px solid var(--btn-danger-border);
  }
  .btn-glass-danger:hover {
    background: var(--btn-danger-hover-bg);
    color: var(--btn-danger-text);
    transform: translateY(-2px);
  }
  .hero {
    text-align: center;
    padding: 30px 0 20px;
  }
  .hero h1 {
    font-size: 36px;
    font-weight: 700;
    margin-bottom: 6px;
    color: var(--hero-color);
    text-shadow: var(--hero-shadow);
  }
  body:not(.dark) .hero h1 {
    background: linear-gradient(90deg, #1a1c2e 0%, #4d96ff 25%, #6b5bff 50%, #4d96ff 75%, #1a1c2e 100%);
    background-size: 200% auto;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    animation: shimmer 4s ease infinite;
    text-shadow: none;
  }
  @keyframes shimmer {
    0% { background-position: 0% center; }
    100% { background-position: 200% center; }
  }
  body.dark .hero h1 {
    background: none;
    -webkit-background-clip: unset;
    -webkit-text-fill-color: unset;
    background-clip: unset;
    color: #fff;
    text-shadow: var(--hero-shadow);
    animation: none;
  }
  .hero .subtitle {
    font-size: 15px;
    color: var(--hero-subtitle);
    font-weight: 500;
  }
  .hero .subtitle span { color: var(--hero-subtitle-span); }
  .stats-row {
    display: flex;
    justify-content: center;
    gap: 16px;
    margin: 20px 0 30px;
    flex-wrap: wrap;
  }
  .stat-card {
    background: var(--stat-bg);
    border: 1px solid var(--stat-border);
    border-radius: 16px;
    padding: 14px 28px;
    text-align: center;
    min-width: 120px;
    transition: all .3s;
    backdrop-filter: blur(8px);
    box-shadow: var(--stat-shadow);
  }
  .stat-card:hover {
    transform: translateY(-4px);
    background: var(--stat-hover-bg);
    border-color: var(--stat-hover-border);
  }
  body:not(.dark) .stat-card {
    animation: float 6s ease-in-out infinite;
  }
  body:not(.dark) .stat-card:nth-child(2) { animation-delay: 0.3s; }
  body:not(.dark) .stat-card:nth-child(3) { animation-delay: 0.6s; }
  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-5px); }
  }
  .stat-card .num {
    font-size: 28px;
    font-weight: 800;
    line-height: 1.2;
  }
  .stat-card .label {
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 1px;
    font-weight: 600;
  }
  .stat-card.late .num { color: var(--stat-num-late); }
  .stat-card.late .label { color: var(--stat-num-late); }
  .stat-card.pending .num { color: var(--stat-num-pending); }
  .stat-card.pending .label { color: var(--stat-num-pending); }
  .stat-card.done .num { color: var(--stat-num-done); }
  .stat-card.done .label { color: var(--stat-num-done); }
  .glass-card {
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: 20px;
    padding: 24px 28px;
    margin-bottom: 24px;
    box-shadow: var(--card-shadow);
    backdrop-filter: blur(8px);
    transition: box-shadow 0.3s ease, transform 0.3s ease;
  }
  body:not(.dark) .glass-card:hover {
    box-shadow: 0 0 30px rgba(77,150,255,0.12), 0 8px 30px rgba(0,0,0,0.06);
  }
  .glass-card.filter-card { position: relative; z-index: 5; }
  .glass-card h4 {
    font-size: 18px;
    font-weight: 700;
    margin-bottom: 16px;
    color: var(--glass-h4);
  }
  .glass-card p.text-muted { color: var(--text-muted) !important; font-size: 14px; }
  .form-glass {
    background: var(--form-bg) !important;
    border: 1px solid var(--form-border) !important;
    color: var(--form-text) !important;
    border-radius: 12px !important;
    padding: 10px 16px !important;
    font-size: 14px !important;
  }
  .form-glass:focus {
    box-shadow: 0 0 0 3px rgba(77,150,255,0.20) !important;
    border-color: #4d96ff !important;
  }
  .form-glass option { background: var(--form-option-bg); color: var(--form-text); }
  .btn-filter {
    background: linear-gradient(135deg, <%= tailColor %>, #4d96ff);
    border: none;
    border-radius: 12px;
    padding: 10px 20px;
    font-weight: 600;
    color: #fff;
    transition: all .3s;
  }
  .btn-filter:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(77,150,255,0.25);
    color: #fff;
  }
  .table-gloss {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0 6px;
  }
  .table-gloss thead th {
    color: var(--th-color);
    font-weight: 600;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 1px;
    border: none;
    padding: 8px 16px;
    background: transparent;
  }
  .table-gloss tbody tr {
    background: var(--table-row);
    border-radius: 14px;
    transition: all .3s;
  }
  .table-gloss tbody tr:hover {
    background: var(--table-row-hover);
    transform: scale(1.005);
  }
  .table-gloss td {
    padding: 14px 16px;
    border: none;
    color: var(--td-color);
    font-size: 14px;
    vertical-align: middle;
  }
  .table-gloss td:first-child { border-radius: 14px 0 0 14px; }
  .table-gloss td:last-child { border-radius: 0 14px 14px 0; }
  .badge-gloss {
    padding: 5px 14px;
    border-radius: 50px;
    font-size: 12px;
    font-weight: 600;
  }
  .badge-late { background: var(--badge-late-bg); color: var(--badge-late-text); border: 1px solid var(--badge-late-border); }
  .badge-pending { background: var(--badge-pending-bg); color: var(--badge-pending-text); border: 1px solid var(--badge-pending-border); }
  .badge-submitted { background: var(--badge-submitted-bg); color: var(--badge-submitted-text); border: 1px solid var(--badge-submitted-border); }
  .btn-action {
    padding: 6px 16px;
    border-radius: 50px;
    font-size: 13px;
    font-weight: 600;
    transition: all .3s;
    text-decoration: none;
    display: inline-block;
  }
  .btn-action-submit { background: linear-gradient(135deg, <%= tailColor %>, #4d96ff); color: #fff; border: none; }
  .btn-action-submit:hover { transform: translateY(-2px); box-shadow: 0 6px 20px rgba(77,150,255,0.25); color:#fff; }
  .btn-action-view { background: var(--action-view-bg); color: var(--action-view-text); border: 1px solid var(--action-view-border); }
  .btn-action-view:hover { background: var(--action-view-hover-bg); color: var(--action-view-hover-text); }
  .btn-action-edit { background: var(--action-edit-bg); color: var(--action-edit-text); border: 1px solid var(--action-edit-border); }
  .btn-action-edit:hover { background: var(--action-edit-hover-bg); color: var(--action-edit-text); }
  .searchable-select { position:relative; width:100%; }
  .searchable-select .form-glass { cursor:pointer; text-align:left; }
  .searchable-menu {
    display:none; position:absolute; top:100%; left:0; right:0; z-index:1000;
    background: var(--menu-bg);
    border: 1px solid var(--menu-border);
    border-radius: 12px;
    padding: 10px;
    max-height: 300px;
    overflow-y: auto;
    box-shadow: 0 12px 50px var(--menu-shadow);
  }
  .searchable-menu.show { display:block; }
  .searchable-menu input { background:var(--menu-input-bg) !important; border:1px solid var(--menu-input-border) !important; color:var(--menu-input-text) !important; border-radius:8px !important; }
  .searchable-menu .dropdown-item {
    cursor:pointer; border-radius:8px; padding:8px 12px;
    color: var(--menu-text);
    transition: all .2s;
    background: none;
    border: none;
    width: 100%;
    text-align: left;
    font-size: 14px;
  }
  .searchable-menu .dropdown-item:hover { background: var(--menu-hover-bg); color: var(--menu-hover-text); }
  .searchable-menu .dropdown-item.active { background: linear-gradient(135deg, <%= tailColor %>, #4d96ff); color:#fff; }
  .modal-gloss .modal-content {
    background: var(--modal-bg);
    border: 1px solid var(--card-border);
    border-radius: 20px;
    color: var(--modal-text);
  }
  .modal-gloss .modal-header { border-bottom: 1px solid var(--divider); }
  .modal-gloss .modal-footer { border-top: 1px solid var(--divider); }
  .modal-gloss .btn-close { filter: var(--close-filter); opacity: 0.5; }
  .empty-state {
    text-align: center;
    padding: 40px 20px;
    color: var(--empty-text);
  }
  .empty-state .icon { font-size: 48px; margin-bottom: 10px; }
  .status-indicator {
    display: inline-block;
    width: 8px; height: 8px;
    border-radius: 50%;
    margin-right: 6px;
  }

  @media (max-width: 768px) {
    #particleCanvas, #tailCanvas { display: none !important; }
    .content-wrap { padding: 16px 16px 40px; }
    .top-bar { flex-direction: column; gap: 12px; align-items: flex-start; }
    .top-bar h2 { font-size: 22px; }
    .top-bar .nav-btns { width: 100%; justify-content: flex-end; }
    .top-right { width: 100%; }
    .theme-switcher { justify-content: flex-end; }
    .hero h1 { font-size: 24px; }
    .hero .subtitle { font-size: 13px; }
    .stats-row { gap: 10px; }
    .stat-card { min-width: 90px; padding: 10px 16px; }
    .stat-card .num { font-size: 22px; }
    .glass-card { padding: 16px; border-radius: 14px; }
    .glass-card h4 { font-size: 16px; }
    .table-gloss thead { display: none; }
    .table-gloss tbody tr {
      display: block;
      padding: 12px;
      margin-bottom: 10px;
      border-radius: 14px;
    }
    .table-gloss td {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 6px 0;
      border-radius: 0 !important;
      border-bottom: 1px solid var(--mobile-td-border);
    }
    .table-gloss td:last-child { border-bottom: none; }
    .table-gloss td::before {
      content: attr(data-label);
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      color: var(--mobile-td-before);
      font-weight: 600;
    }
    .btn-filter { width: 100%; }
    .row.g-3 > div { margin-bottom: 8px; }
  }
        .site-footer { text-align:center; padding:16px 12px; margin-top:40px; font-size:13px; color:#8a8fa8; border-top:1px solid rgba(0,0,0,0.06); }
        @media (max-width:480px) { .site-footer { font-size:11px; padding:12px 8px; } }
</style>
</head>
<body>

<canvas id="particleCanvas"></canvas>

<div class="content-wrap">

  <div class="top-bar">
    <h2>Student Dashboard</h2>
    <div class="top-right">
      <div class="nav-btns">
        <a href="/student/calendar" class="btn-glass">Calendar</a>
        <a href="/logout" class="btn-glass-danger">Logout</a>
      </div>
      <div class="theme-switcher">
        <button class="theme-dot dot-light" title="Light theme" onclick="setTheme('light')"></button>
        <button class="theme-dot dot-dark" title="Dark theme" onclick="setTheme('dark')"></button>
      </div>
    </div>
  </div>

  <div class="hero">
    <h1>Welcome, <%= user.name %></h1>
    <div class="subtitle">
      <span><%= user.level || 'UG' %></span> &middot;
      <span><%= user.department %></span> &middot;
      <span>Year <%= user.year %></span> &middot;
      <span>Sem <%= user.semester || '-' %></span>
    </div>
  </div>

  <div class="stats-row">
    <div class="stat-card late">
      <div class="num"><%= assignments.filter(a => a.status === 'Late').length %></div>
      <div class="label">Late</div>
    </div>
    <div class="stat-card pending">
      <div class="num"><%= assignments.filter(a => a.status === 'Pending').length %></div>
      <div class="label">Pending</div>
    </div>
    <div class="stat-card done">
      <div class="num"><%= assignments.filter(a => a.status === 'Submitted').length %></div>
      <div class="label">Done</div>
    </div>
  </div>

  <div class="glass-card filter-card">
    <h4>Filters</h4>
    <form action="/student" method="GET">
      <% Object.keys(queryFilters).forEach(function(key) { %>
        <% if (key !== 'subject' && key !== 'status') { %>
          <input type="hidden" name="<%= key %>" value="<%= queryFilters[key] %>">
        <% } %>
      <% }); %>
      <div class="row g-3">
        <div class="col-md-4">
          <div class="searchable-select">
            <button class="form-glass form-select dropdown-toggle" type="button" onclick="searchableToggle(this)">
              <%= queryFilters.subject || 'All Subjects' %>
            </button>
            <div class="searchable-menu">
              <input type="text" class="form-control form-control-sm mb-2" placeholder="Search..." oninput="searchableFilter(this)" onclick="event.stopPropagation()">
              <button type="button" class="dropdown-item" data-value="" onclick="searchablePick(this)">All Subjects</button>
              <% subjects.forEach(function(s) { %>
                <button type="button" class="dropdown-item<%= queryFilters.subject === s ? ' active' : '' %>" data-value="<%= s %>" onclick="searchablePick(this)"><%= s %></button>
              <% }); %>
            </div>
            <input type="hidden" name="subject" value="<%= queryFilters.subject || '' %>">
          </div>
        </div>
        <div class="col-md-4">
          <select class="form-glass form-select" name="status">
            <option>All Statuses</option>
            <option value="Submitted" <%= queryFilters.status === 'Submitted' ? 'selected' : '' %>>Submitted</option>
            <option value="Pending" <%= queryFilters.status === 'Pending' ? 'selected' : '' %>>Pending</option>
            <option value="Late" <%= queryFilters.status === 'Late' ? 'selected' : '' %>>Late</option>
          </select>
        </div>
        <div class="col-md-2">
          <button type="submit" class="btn btn-filter w-100">Filter</button>
        </div>
      </div>
    </form>
  </div>

  <div class="glass-card">
    <div class="d-flex justify-content-between align-items-center mb-3">
      <h4 style="margin-bottom:0;">My Assignments</h4>
      <span style="color:var(--text-muted); font-size:13px;"><%= assignments.length %> assignment(s)</span>
    </div>
    <table class="table-gloss">
      <thead>
        <tr>
          <th>Title</th>
          <th>Subject</th>
          <th>Due Date</th>
          <th>Status</th>
          <th>Action</th>
        </tr>
      </thead>
      <tbody>
        <% if(assignments.length === 0) { %>
          <tr><td colspan="5" data-label=""><div class="empty-state"><div class="icon">🎉</div>No assignments found</div></td></tr>
        <% } else { %>
          <% assignments.forEach(function(a) { %>
          <tr>
            <td data-label="Title"><strong><%= a.title %></strong><br><span style="font-size:12px;color:var(--text-muted);"><%= a.assignedBy || 'Admin' %></span></td>
            <td data-label="Subject"><%= a.subject %></td>
            <td data-label="Due Date"><%= new Date(a.dueDate).toLocaleDateString() %></td>
            <td data-label="Status">
              <% if(a.status === 'Submitted') { %>
                <span class="badge-gloss badge-submitted"><span class="status-indicator" style="background:var(--badge-submitted-text)"></span>Submitted<%= a.isLate ? ' (Late)' : '' %></span>
              <% } else if(a.status === 'Pending') { %>
                <span class="badge-gloss badge-pending"><span class="status-indicator" style="background:var(--badge-pending-text)"></span>Pending</span>
              <% } else if(a.status === 'Late') { %>
                <span class="badge-gloss badge-late"><span class="status-indicator" style="background:var(--badge-late-text)"></span>Late</span>
              <% } %>
            </td>
            <td data-label="Action">
              <% if(a.status === 'Submitted') { %>
                <a href="<%= a.submission.link || '#' %>" target="_blank" class="btn-action btn-action-view me-1">View</a>
                <button class="btn-action btn-action-edit" onclick="openSubmitModal(<%= a.id %>, '<%= a.title.replace(/'/g, "\\'") %>', '<%= (a.submission.link || '').replace(/'/g, "\\'") %>')">Edit</button>
              <% } else { %>
                <button class="btn-action btn-action-submit" onclick="openSubmitModal(<%= a.id %>, '<%= a.title.replace(/'/g, "\\'") %>', '')">Submit</button>
              <% } %>
            </td>
          </tr>
          <% }); %>
        <% } %>
      </tbody>
    </table>
  </div>

</div>

<div class="modal fade modal-gloss" id="submitModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <form id="submitForm" method="POST" action="" novalidate>
        <div class="modal-header">
          <h5 class="modal-title">Submit Assignment</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <p><strong>Assignment:</strong> <span id="modalAssignmentTitle"></span></p>
          <div class="mb-3">
            <label class="form-label" style="color:var(--form-label);">Submission Link (optional)</label>
            <input type="text" class="form-control form-glass" name="link" id="modalSubmissionLink" placeholder="https://...">
            <div class="form-check mt-2">
              <input class="form-check-input" type="checkbox" id="submitWithoutLink" onchange="toggleLinkInput()">
              <label class="form-check-label" for="submitWithoutLink" style="color:var(--text-muted);font-size:14px;">Submit without link</label>
            </div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-glass" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-filter">Save Submission</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
const TAIL_COLOR = '<%= tailColor %>';
const isMobile = window.innerWidth < 768 || ('ontouchstart' in window);
let particleAnimId = null;
let tailAnimId = null;

function startParticles() {
  if (isMobile) return;
  const canvas = document.getElementById('particleCanvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  let W, H;
  let mouseX = -1000, mouseY = -1000;
  let particles = [];
  const PARTICLE_COUNT = 70;
  const CONNECT_DIST = 130;

  function resize() { W = canvas.width = window.innerWidth; H = canvas.height = window.innerHeight; }
  window.addEventListener('resize', resize);
  resize();

  document.addEventListener('mousemove', e => { mouseX = e.clientX; mouseY = e.clientY; });
  document.addEventListener('mouseleave', () => { mouseX = -1000; mouseY = -1000; });

  class Particle {
    constructor() { this.reset(); }
    reset() {
      this.x = Math.random() * W; this.y = Math.random() * H;
      this.vx = (Math.random() - 0.5) * 1.2; this.vy = (Math.random() - 0.5) * 1.2;
      this.r = Math.random() * 2.5 + 1.5; this.hue = Math.random() * 360;
    }
    update() {
      const dx = mouseX - this.x, dy = mouseY - this.y, dist = Math.sqrt(dx*dx+dy*dy);
      if (dist < 200) { const f = (200-dist)/200*0.06; this.vx+=dx*f; this.vy+=dy*f; }
      this.vx*=0.98; this.vy*=0.98; this.x+=this.vx; this.y+=this.vy;
      if (this.x<0||this.x>W){this.vx*=-1;this.x=Math.max(0,Math.min(W,this.x));}
      if (this.y<0||this.y>H){this.vy*=-1;this.y=Math.max(0,Math.min(H,this.y));}
    }
    draw() {
      ctx.beginPath(); ctx.arc(this.x,this.y,this.r,0,Math.PI*2);
      ctx.fillStyle = `hsla(${this.hue},80%,60%,0.25)`; ctx.fill();
    }
  }

  for (let i = 0; i < PARTICLE_COUNT; i++) particles.push(new Particle());

  function drawConnections() {
    for (let i=0;i<particles.length;i++) for (let j=i+1;j<particles.length;j++) {
      const dx=particles[i].x-particles[j].x, dy=particles[i].y-particles[j].y, dist=Math.sqrt(dx*dx+dy*dy);
      if (dist<CONNECT_DIST) {
        const a=(1-dist/CONNECT_DIST)*0.06, h=(particles[i].hue+particles[j].hue)/2;
        ctx.beginPath(); ctx.moveTo(particles[i].x,particles[i].y); ctx.lineTo(particles[j].x,particles[j].y);
        ctx.strokeStyle=`hsla(${h},60%,70%,${a})`; ctx.lineWidth=0.8; ctx.stroke();
      }
    }
  }

  function animate() {
    ctx.clearRect(0,0,W,H); particles.forEach(p=>{p.update();p.draw();}); drawConnections();
    particleAnimId = requestAnimationFrame(animate);
  }
  animate();
}

function startMouseTail() {
  if (isMobile) return;
  const canvas = document.createElement('canvas');
  canvas.id = 'tailCanvas';
  canvas.style.cssText = 'position:fixed;top:0;left:0;width:100vw;height:100vh;z-index:9999;pointer-events:none;';
  document.body.appendChild(canvas);
  const ctx = canvas.getContext('2d');
  let W, H;
  function resize() { W=canvas.width=window.innerWidth; H=canvas.height=window.innerHeight; }
  window.addEventListener('resize',resize); resize();

  let sparks=[], mx=-100, my=-100;
  document.addEventListener('mousemove',e=>{mx=e.clientX;my=e.clientY;for(let i=0;i<3;i++){sparks.push({x:mx+(Math.random()-0.5)*4,y:my+(Math.random()-0.5)*4,vx:(Math.random()-0.5)*3,vy:(Math.random()-0.5)*3-1.5,life:1,size:Math.random()*4+2,decay:0.015+Math.random()*0.02});}});

  function animateTail() {
    ctx.clearRect(0,0,W,H); sparks=sparks.filter(s=>s.life>0);
    sparks.forEach(s=>{s.x+=s.vx;s.y+=s.vy;s.vy+=0.03;s.life-=s.decay;s.size*=0.99;ctx.beginPath();ctx.arc(s.x,s.y,s.size*s.life,0,Math.PI*2);ctx.fillStyle=TAIL_COLOR;ctx.globalAlpha=s.life*0.6;ctx.fill();ctx.globalAlpha=1;});
    tailAnimId = requestAnimationFrame(animateTail);
  }
  animateTail();
}

function stopAnimations() {
  if (particleAnimId) { cancelAnimationFrame(particleAnimId); particleAnimId = null; }
  if (tailAnimId) { cancelAnimationFrame(tailAnimId); tailAnimId = null; }
  const tc = document.getElementById('tailCanvas'); if (tc) tc.remove();
}

function setTheme(theme) {
  const dots = document.querySelectorAll('.theme-dot');
  if (theme === 'dark') {
    document.body.classList.add('dark');
    localStorage.setItem('studentTheme', 'dark');
    if (!isMobile) { startParticles(); startMouseTail(); }
  } else {
    document.body.classList.remove('dark');
    localStorage.setItem('studentTheme', 'light');
    stopAnimations();
  }
  dots.forEach(d => d.classList.remove('active'));
  document.querySelector('.theme-dot.dot-' + theme).classList.add('active');
}

(function initTheme() {
  const saved = localStorage.getItem('studentTheme') || 'light';
  setTheme(saved);
  document.querySelector('.theme-dot.dot-' + saved).classList.add('active');
})();
</script>
<script>
function searchableToggle(btn) {
  var menu = btn.nextElementSibling;
  var isOpen = menu.classList.contains('show');
  document.querySelectorAll('.searchable-menu.show').forEach(function(m) { if (m !== menu) m.classList.remove('show'); });
  menu.classList.toggle('show');
  if (!isOpen) { var inp = menu.querySelector('input'); if(inp) { inp.value = ''; inp.focus(); } menu.querySelectorAll('.dropdown-item').forEach(function(it) { it.style.display = ''; }); }
}
function searchableFilter(inp) {
  var val = inp.value.toLowerCase();
  inp.parentNode.querySelectorAll('.dropdown-item').forEach(function(it) { it.style.display = it.textContent.toLowerCase().indexOf(val) > -1 ? '' : 'none'; });
}
function searchablePick(item) {
  var menu = item.closest('.searchable-menu');
  var container = menu.closest('.searchable-select');
  var btn = container.querySelector('.dropdown-toggle');
  var hidden = container.querySelector('input[type="hidden"]');
  btn.textContent = item.textContent;
  hidden.value = item.getAttribute('data-value') || '';
  menu.querySelectorAll('.dropdown-item').forEach(function(it) { it.classList.remove('active'); });
  item.classList.add('active');
  menu.classList.remove('show');
}
document.addEventListener('click', function(e) { if (!e.target.closest('.searchable-select')) { document.querySelectorAll('.searchable-menu.show').forEach(function(m) { m.classList.remove('show'); }); } });
</script>
<script>
function toggleLinkInput() {
  var chk = document.getElementById('submitWithoutLink');
  var inp = document.getElementById('modalSubmissionLink');
  inp.disabled = chk.checked;
  inp.required = !chk.checked;
  if (chk.checked) inp.value = '';
}
function openSubmitModal(id, title, existingLink) {
  document.getElementById('modalAssignmentTitle').innerText = title;
  document.getElementById('modalSubmissionLink').value = existingLink || '';
  document.getElementById('modalSubmissionLink').required = !existingLink;
  document.getElementById('submitWithoutLink').checked = false;
  document.getElementById('modalSubmissionLink').disabled = false;
  document.getElementById('submitForm').action = '/student/submit/' + id;
  var submitModal = new bootstrap.Modal(document.getElementById('submitModal'));
  submitModal.show();
}
</script>

