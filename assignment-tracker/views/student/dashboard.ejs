<!DOCTYPE html>
<html>
<head>
<title>Student Dashboard</title>
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<style>
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');
  * { margin:0; padding:0; box-sizing:border-box; }
  body {
    font-family: 'Inter', sans-serif;
    overflow-x: hidden;
    min-height: 100vh;
    background: linear-gradient(135deg, #f0f4ff 0%, #e8ecf8 100%);
    color: #1a1c2e;
  }
  #particleCanvas {
    position: fixed;
    top: 0; left: 0;
    width: 100vw; height: 100vh;
    z-index: 0;
    pointer-events: none;
  }
  .content-wrap {
    position: relative;
    z-index: 1;
    min-height: 100vh;
    padding: 30px 40px 60px;
  }
  .top-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 30px;
  }
  .top-bar h2 {
    font-weight: 800;
    font-size: 28px;
    background: linear-gradient(135deg, <%= tailColor %>, #4d96ff);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin: 0;
  }
  .top-bar .nav-btns { display:flex; gap:12px; }
  .top-bar .nav-btns a {
    padding: 8px 20px;
    border-radius: 50px;
    font-weight: 600;
    font-size: 14px;
    text-decoration: none;
    transition: all .3s;
  }
  .btn-glass {
    background: #fff;
    color: #4a4e6b;
    border: 1px solid #e2e4ed;
    box-shadow: 0 2px 8px rgba(0,0,0,0.04);
  }
  .btn-glass:hover {
    background: #f5f6fa;
    color: #1a1c2e;
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(0,0,0,0.08);
  }
  .btn-glass-danger {
    background: #fff0f0;
    color: #d14545;
    border: 1px solid #ffd4d4;
  }
  .btn-glass-danger:hover {
    background: #ffe0e0;
    color: #d14545;
    transform: translateY(-2px);
  }
  .hero {
    text-align: center;
    padding: 30px 0 20px;
  }
  .hero h1 {
    font-size: 36px;
    font-weight: 700;
    margin-bottom: 6px;
    color: #1a1c2e;
  }
  .hero .subtitle {
    font-size: 15px;
    color: #8a8fa8;
    font-weight: 500;
  }
  .hero .subtitle span { color: #4a4e6b; }
  .stats-row {
    display: flex;
    justify-content: center;
    gap: 16px;
    margin: 20px 0 30px;
    flex-wrap: wrap;
  }
  .stat-card {
    background: #fff;
    border: 1px solid #e2e4ed;
    border-radius: 16px;
    padding: 14px 28px;
    text-align: center;
    min-width: 120px;
    transition: all .3s;
    box-shadow: 0 2px 8px rgba(0,0,0,0.04);
  }
  .stat-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 40px rgba(0,0,0,0.08);
  }
  .stat-card .num {
    font-size: 28px;
    font-weight: 800;
    line-height: 1.2;
  }
  .stat-card .label {
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 1px;
    font-weight: 600;
  }
  .stat-card.late .num { color: #d14545; }
  .stat-card.late .label { color: #d14545; }
  .stat-card.pending .num { color: #e6a020; }
  .stat-card.pending .label { color: #e6a020; }
  .stat-card.done .num { color: #2b9e4a; }
  .stat-card.done .label { color: #2b9e4a; }
  .glass-card {
    background: #fff;
    border: 1px solid #e2e4ed;
    border-radius: 20px;
    padding: 24px 28px;
    margin-bottom: 24px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.04);
  }
  .glass-card.filter-card { position: relative; z-index: 5; }
  .glass-card h4 {
    font-size: 18px;
    font-weight: 700;
    margin-bottom: 16px;
    color: #1a1c2e;
  }
  .glass-card p.text-muted { color: #8a8fa8 !important; font-size: 14px; }
  .form-glass {
    background: #f5f6fa !important;
    border: 1px solid #e2e4ed !important;
    color: #1a1c2e !important;
    border-radius: 12px !important;
    padding: 10px 16px !important;
    font-size: 14px !important;
  }
  .form-glass:focus {
    box-shadow: 0 0 0 3px rgba(77,150,255,0.12) !important;
    border-color: #4d96ff !important;
  }
  .form-glass option { background:#fff; color:#1a1c2e; }
  .btn-filter {
    background: linear-gradient(135deg, <%= tailColor %>, #4d96ff);
    border: none;
    border-radius: 12px;
    padding: 10px 20px;
    font-weight: 600;
    color: #fff;
    transition: all .3s;
  }
  .btn-filter:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(77,150,255,0.25);
    color: #fff;
  }
  .table-gloss {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0 6px;
  }
  .table-gloss thead th {
    color: #8a8fa8;
    font-weight: 600;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 1px;
    border: none;
    padding: 8px 16px;
    background: transparent;
  }
  .table-gloss tbody tr {
    background: #f8f9fd;
    border-radius: 14px;
    transition: all .3s;
  }
  .table-gloss tbody tr:hover {
    background: #f0f2f8;
    transform: scale(1.005);
  }
  .table-gloss td {
    padding: 14px 16px;
    border: none;
    color: #4a4e6b;
    font-size: 14px;
    vertical-align: middle;
  }
  .table-gloss td:first-child { border-radius: 14px 0 0 14px; }
  .table-gloss td:last-child { border-radius: 0 14px 14px 0; }
  .badge-gloss {
    padding: 5px 14px;
    border-radius: 50px;
    font-size: 12px;
    font-weight: 600;
  }
  .badge-late { background: #fff0f0; color: #d14545; border: 1px solid #ffd4d4; }
  .badge-pending { background: #fff8e6; color: #e6a020; border: 1px solid #ffe8b8; }
  .badge-submitted { background: #eafaef; color: #2b9e4a; border: 1px solid #c6ebd4; }
  .btn-action {
    padding: 6px 16px;
    border-radius: 50px;
    font-size: 13px;
    font-weight: 600;
    transition: all .3s;
    text-decoration: none;
    display: inline-block;
  }
  .btn-action-submit { background: linear-gradient(135deg, <%= tailColor %>, #4d96ff); color: #fff; border: none; }
  .btn-action-submit:hover { transform: translateY(-2px); box-shadow: 0 6px 20px rgba(77,150,255,0.25); color:#fff; }
  .btn-action-view { background: #f0f2f8; color: #4a4e6b; border: 1px solid #e2e4ed; }
  .btn-action-view:hover { background: #e5e7ef; color: #1a1c2e; }
  .btn-action-edit { background: #e8f0fe; color: #4d96ff; border: 1px solid #cde0fc; }
  .btn-action-edit:hover { background: #d4e4fc; color: #4d96ff; }
  .searchable-select { position:relative; width:100%; }
  .searchable-select .form-glass { cursor:pointer; text-align:left; }
  .searchable-menu {
    display:none; position:absolute; top:100%; left:0; right:0; z-index:1000;
    background: #fff;
    border: 1px solid #e2e4ed;
    border-radius: 12px;
    padding: 10px;
    max-height: 300px;
    overflow-y: auto;
    box-shadow: 0 12px 50px rgba(0,0,0,0.1);
  }
  .searchable-menu.show { display:block; }
  .searchable-menu input { background:#f5f6fa !important; border:1px solid #e2e4ed !important; color:#1a1c2e !important; border-radius:8px !important; }
  .searchable-menu .dropdown-item {
    cursor:pointer; border-radius:8px; padding:8px 12px;
    color: #4a4e6b;
    transition: all .2s;
    background: none;
    border: none;
    width: 100%;
    text-align: left;
    font-size: 14px;
  }
  .searchable-menu .dropdown-item:hover { background:#f0f2f8; color:#1a1c2e; }
  .searchable-menu .dropdown-item.active { background: linear-gradient(135deg, <%= tailColor %>, #4d96ff); color:#fff; }
  .modal-gloss .modal-content {
    background: #fff;
    border: 1px solid #e2e4ed;
    border-radius: 20px;
    color: #1a1c2e;
  }
  .modal-gloss .modal-header { border-bottom: 1px solid #e2e4ed; }
  .modal-gloss .modal-footer { border-top: 1px solid #e2e4ed; }
  .modal-gloss .btn-close { opacity: 0.5; }
  .empty-state {
    text-align: center;
    padding: 40px 20px;
    color: #8a8fa8;
  }
  .empty-state .icon { font-size: 48px; margin-bottom: 10px; }
  .status-indicator {
    display: inline-block;
    width: 8px; height: 8px;
    border-radius: 50%;
    margin-right: 6px;
  }

  @media (max-width: 768px) {
    #particleCanvas, #tailCanvas { display: none; }
    .content-wrap { padding: 16px 16px 40px; }
    .top-bar { flex-direction: column; gap: 12px; align-items: flex-start; }
    .top-bar h2 { font-size: 22px; }
    .top-bar .nav-btns { width: 100%; justify-content: flex-end; }
    .hero h1 { font-size: 24px; }
    .hero .subtitle { font-size: 13px; }
    .stats-row { gap: 10px; }
    .stat-card { min-width: 90px; padding: 10px 16px; }
    .stat-card .num { font-size: 22px; }
    .glass-card { padding: 16px; border-radius: 14px; }
    .glass-card h4 { font-size: 16px; }
    .table-gloss thead { display: none; }
    .table-gloss tbody tr {
      display: block;
      padding: 12px;
      margin-bottom: 10px;
      border-radius: 14px;
    }
    .table-gloss td {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 6px 0;
      border-radius: 0 !important;
      border-bottom: 1px solid rgba(0,0,0,0.04);
    }
    .table-gloss td:last-child { border-bottom: none; }
    .table-gloss td::before {
      content: attr(data-label);
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      color: #8a8fa8;
      font-weight: 600;
    }
    .btn-filter { width: 100%; }
    .row.g-3 > div { margin-bottom: 8px; }
  }
</style>
</head>
<body>

<canvas id="particleCanvas"></canvas>

<div class="content-wrap">

  <div class="top-bar">
    <h2>Student Dashboard</h2>
    <div class="nav-btns">
      <a href="/student/calendar" class="btn-glass">Calendar</a>
      <a href="/logout" class="btn-glass-danger">Logout</a>
    </div>
  </div>

  <div class="hero">
    <h1>Welcome, <%= user.name %></h1>
    <div class="subtitle">
      <span><%= user.level || 'UG' %></span> &middot;
      <span><%= user.department %></span> &middot;
      <span>Year <%= user.year %></span> &middot;
      <span>Sem <%= user.semester || '-' %></span>
    </div>
  </div>

  <div class="stats-row">
    <div class="stat-card late">
      <div class="num"><%= assignments.filter(a => a.status === 'Late').length %></div>
      <div class="label">Late</div>
    </div>
    <div class="stat-card pending">
      <div class="num"><%= assignments.filter(a => a.status === 'Pending').length %></div>
      <div class="label">Pending</div>
    </div>
    <div class="stat-card done">
      <div class="num"><%= assignments.filter(a => a.status === 'Submitted').length %></div>
      <div class="label">Done</div>
    </div>
  </div>

  <div class="glass-card filter-card">
    <h4>Filters</h4>
    <form action="/student" method="GET">
      <% Object.keys(queryFilters).forEach(function(key) { %>
        <% if (key !== 'subject' && key !== 'status') { %>
          <input type="hidden" name="<%= key %>" value="<%= queryFilters[key] %>">
        <% } %>
      <% }); %>
      <div class="row g-3">
        <div class="col-md-4">
          <div class="searchable-select">
            <button class="form-glass form-select dropdown-toggle" type="button" onclick="searchableToggle(this)">
              <%= queryFilters.subject || 'All Subjects' %>
            </button>
            <div class="searchable-menu">
              <input type="text" class="form-control form-control-sm mb-2" placeholder="Search..." oninput="searchableFilter(this)" onclick="event.stopPropagation()">
              <button type="button" class="dropdown-item" data-value="" onclick="searchablePick(this)">All Subjects</button>
              <% subjects.forEach(function(s) { %>
                <button type="button" class="dropdown-item<%= queryFilters.subject === s ? ' active' : '' %>" data-value="<%= s %>" onclick="searchablePick(this)"><%= s %></button>
              <% }); %>
            </div>
            <input type="hidden" name="subject" value="<%= queryFilters.subject || '' %>">
          </div>
        </div>
        <div class="col-md-4">
          <select class="form-glass form-select" name="status">
            <option>All Statuses</option>
            <option value="Submitted" <%= queryFilters.status === 'Submitted' ? 'selected' : '' %>>Submitted</option>
            <option value="Pending" <%= queryFilters.status === 'Pending' ? 'selected' : '' %>>Pending</option>
            <option value="Late" <%= queryFilters.status === 'Late' ? 'selected' : '' %>>Late</option>
          </select>
        </div>
        <div class="col-md-2">
          <button type="submit" class="btn btn-filter w-100">Filter</button>
        </div>
      </div>
    </form>
  </div>

  <div class="glass-card">
    <div class="d-flex justify-content-between align-items-center mb-3">
      <h4 style="margin-bottom:0;">My Assignments</h4>
      <span style="color:#8a8fa8; font-size:13px;"><%= assignments.length %> assignment(s)</span>
    </div>
    <table class="table-gloss">
      <thead>
        <tr>
          <th>Title</th>
          <th>Subject</th>
          <th>Due Date</th>
          <th>Status</th>
          <th>Action</th>
        </tr>
      </thead>
      <tbody>
        <% if(assignments.length === 0) { %>
          <tr><td colspan="5" data-label=""><div class="empty-state"><div class="icon">🎉</div>No assignments found</div></td></tr>
        <% } else { %>
          <% assignments.forEach(function(a) { %>
          <tr>
            <td data-label="Title"><strong><%= a.title %></strong><br><span style="font-size:12px;color:#8a8fa8;"><%= a.assignedBy || 'Admin' %></span></td>
            <td data-label="Subject"><%= a.subject %></td>
            <td data-label="Due Date"><%= new Date(a.dueDate).toLocaleDateString() %></td>
            <td data-label="Status">
              <% if(a.status === 'Submitted') { %>
                <span class="badge-gloss badge-submitted"><span class="status-indicator" style="background:#2b9e4a"></span>Submitted<%= a.isLate ? ' (Late)' : '' %></span>
              <% } else if(a.status === 'Pending') { %>
                <span class="badge-gloss badge-pending"><span class="status-indicator" style="background:#e6a020"></span>Pending</span>
              <% } else if(a.status === 'Late') { %>
                <span class="badge-gloss badge-late"><span class="status-indicator" style="background:#d14545"></span>Late</span>
              <% } %>
            </td>
            <td data-label="Action">
              <% if(a.status === 'Submitted') { %>
                <a href="<%= a.submission.link %>" target="_blank" class="btn-action btn-action-view me-1">View</a>
                <button class="btn-action btn-action-edit" onclick="openSubmitModal(<%= a.id %>, '<%= a.title.replace(/'/g, "\\'") %>', '<%= a.submission.link.replace(/'/g, "\\'") %>')">Edit</button>
              <% } else { %>
                <button class="btn-action btn-action-submit" onclick="openSubmitModal(<%= a.id %>, '<%= a.title.replace(/'/g, "\\'") %>', '')">Submit</button>
              <% } %>
            </td>
          </tr>
          <% }); %>
        <% } %>
      </tbody>
    </table>
  </div>

</div>

<div class="modal fade modal-gloss" id="submitModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <form id="submitForm" method="POST" action="">
        <div class="modal-header">
          <h5 class="modal-title">Submit Assignment</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <p><strong>Assignment:</strong> <span id="modalAssignmentTitle"></span></p>
          <div class="mb-3">
            <label class="form-label" style="color:#4a4e6b;">Submission Link (Google Drive, Image URL, YouTube Video, etc.)</label>
            <input type="url" class="form-control form-glass" name="link" id="modalSubmissionLink" placeholder="https://..." required>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-glass" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-filter">Save Submission</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
const TAIL_COLOR = '<%= tailColor %>';
const isMobile = window.innerWidth < 768 || ('ontouchstart' in window);

if (!isMobile) {
(function initParticles() {
  const canvas = document.getElementById('particleCanvas');
  const ctx = canvas.getContext('2d');
  let W, H;
  let mouseX = -1000, mouseY = -1000;
  let particles = [];
  const PARTICLE_COUNT = 60;
  const CONNECT_DIST = 120;

  function resize() {
    W = canvas.width = window.innerWidth;
    H = canvas.height = window.innerHeight;
  }
  window.addEventListener('resize', resize);
  resize();

  document.addEventListener('mousemove', e => { mouseX = e.clientX; mouseY = e.clientY; });
  document.addEventListener('mouseleave', () => { mouseX = -1000; mouseY = -1000; });

  class Particle {
    constructor(i) { this.index = i; this.reset(); }
    reset() {
      this.x = Math.random() * W;
      this.y = Math.random() * H;
      this.vx = (Math.random() - 0.5) * 1.2;
      this.vy = (Math.random() - 0.5) * 1.2;
      this.r = Math.random() * 2.5 + 1.5;
    }
    update() {
      const dx = mouseX - this.x;
      const dy = mouseY - this.y;
      const dist = Math.sqrt(dx * dx + dy * dy);
      if (dist < 200) {
        const force = (200 - dist) / 200 * 0.06;
        this.vx += dx * force;
        this.vy += dy * force;
      }
      this.vx *= 0.98;
      this.vy *= 0.98;
      this.x += this.vx;
      this.y += this.vy;
      if (this.x < 0 || this.x > W) { this.vx *= -1; this.x = Math.max(0, Math.min(W, this.x)); }
      if (this.y < 0 || this.y > H) { this.vy *= -1; this.y = Math.max(0, Math.min(H, this.y)); }
    }
    draw() {
      ctx.beginPath();
      ctx.arc(this.x, this.y, this.r, 0, Math.PI * 2);
      ctx.fillStyle = `rgba(77, 150, 255, 0.2)`;
      ctx.fill();
    }
  }

  for (let i = 0; i < PARTICLE_COUNT; i++) particles.push(new Particle(i));

  function drawConnections() {
    for (let i = 0; i < particles.length; i++) {
      for (let j = i + 1; j < particles.length; j++) {
        const dx = particles[i].x - particles[j].x;
        const dy = particles[i].y - particles[j].y;
        const dist = Math.sqrt(dx * dx + dy * dy);
        if (dist < CONNECT_DIST) {
          const alpha = (1 - dist / CONNECT_DIST) * 0.08;
          ctx.beginPath();
          ctx.moveTo(particles[i].x, particles[i].y);
          ctx.lineTo(particles[j].x, particles[j].y);
          ctx.strokeStyle = `rgba(77, 150, 255, ${alpha})`;
          ctx.lineWidth = 0.8;
          ctx.stroke();
        }
      }
    }
  }

  function animate() {
    ctx.clearRect(0, 0, W, H);
    particles.forEach(p => { p.update(); p.draw(); });
    drawConnections();
    requestAnimationFrame(animate);
  }
  animate();
})();
}

if (!isMobile) {
(function initMouseTail() {
  const canvas = document.createElement('canvas');
  canvas.id = 'tailCanvas';
  canvas.style.cssText = 'position:fixed;top:0;left:0;width:100vw;height:100vh;z-index:9999;pointer-events:none;';
  document.body.appendChild(canvas);
  const ctx = canvas.getContext('2d');
  let W, H;
  function resize() { W = canvas.width = window.innerWidth; H = canvas.height = window.innerHeight; }
  window.addEventListener('resize', resize);
  resize();

  let sparks = [];
  let mx = -100, my = -100;

  document.addEventListener('mousemove', e => {
    mx = e.clientX; my = e.clientY;
    for (let i = 0; i < 3; i++) {
      sparks.push({
        x: mx + (Math.random() - 0.5) * 4,
        y: my + (Math.random() - 0.5) * 4,
        vx: (Math.random() - 0.5) * 3,
        vy: (Math.random() - 0.5) * 3 - 1.5,
        life: 1,
        size: Math.random() * 4 + 2,
        decay: 0.015 + Math.random() * 0.02
      });
    }
  });

  function animateTail() {
    ctx.clearRect(0, 0, W, H);
    sparks = sparks.filter(s => s.life > 0);
    sparks.forEach(s => {
      s.x += s.vx;
      s.y += s.vy;
      s.vy += 0.03;
      s.life -= s.decay;
      s.size *= 0.99;
      ctx.beginPath();
      ctx.arc(s.x, s.y, s.size * s.life, 0, Math.PI * 2);
      ctx.fillStyle = TAIL_COLOR;
      ctx.globalAlpha = s.life * 0.6;
      ctx.fill();
      ctx.globalAlpha = 1;
    });
    requestAnimationFrame(animateTail);
  }
  animateTail();
})();
}
</script>
<script>
function searchableToggle(btn) {
  var menu = btn.nextElementSibling;
  var isOpen = menu.classList.contains('show');
  document.querySelectorAll('.searchable-menu.show').forEach(function(m) { if (m !== menu) m.classList.remove('show'); });
  menu.classList.toggle('show');
  if (!isOpen) { var inp = menu.querySelector('input'); if(inp) { inp.value = ''; inp.focus(); } menu.querySelectorAll('.dropdown-item').forEach(function(it) { it.style.display = ''; }); }
}
function searchableFilter(inp) {
  var val = inp.value.toLowerCase();
  inp.parentNode.querySelectorAll('.dropdown-item').forEach(function(it) { it.style.display = it.textContent.toLowerCase().indexOf(val) > -1 ? '' : 'none'; });
}
function searchablePick(item) {
  var menu = item.closest('.searchable-menu');
  var container = menu.closest('.searchable-select');
  var btn = container.querySelector('.dropdown-toggle');
  var hidden = container.querySelector('input[type="hidden"]');
  btn.textContent = item.textContent;
  hidden.value = item.getAttribute('data-value') || '';
  menu.querySelectorAll('.dropdown-item').forEach(function(it) { it.classList.remove('active'); });
  item.classList.add('active');
  menu.classList.remove('show');
}
document.addEventListener('click', function(e) { if (!e.target.closest('.searchable-select')) { document.querySelectorAll('.searchable-menu.show').forEach(function(m) { m.classList.remove('show'); }); } });
</script>
<script>
function openSubmitModal(id, title, existingLink) {
  document.getElementById('modalAssignmentTitle').innerText = title;
  document.getElementById('modalSubmissionLink').value = existingLink;
  document.getElementById('submitForm').action = '/student/submit/' + id;
  var submitModal = new bootstrap.Modal(document.getElementById('submitModal'));
  submitModal.show();
}
</script>

</body>
</html>