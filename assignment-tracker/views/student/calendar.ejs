<!DOCTYPE html>
<html>
<head>
    <title>My Calendar</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.15/index.global.min.css" rel="stylesheet">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');
        * { margin:0; padding:0; box-sizing:border-box; }
        body {
            font-family: 'Inter', sans-serif;
            background: linear-gradient(135deg, #050916 0%, #0a0e27 40%, #0d1635 70%, #0a1128 100%);
            color: #e0e4f0;
            overflow-x: hidden;
            min-height: 100vh;
        }
        .container-custom { max-width: 1100px; margin: 0 auto; padding: 30px 40px 60px; }
        .top-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 30px;
        }
        .top-bar h2 {
            font-weight: 800;
            font-size: 28px;
            background: linear-gradient(135deg, #4d96ff, #6b5bff);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            margin: 0;
        }
        .btn-glass {
            padding: 8px 20px;
            border-radius: 50px;
            font-weight: 600;
            font-size: 14px;
            text-decoration: none;
            background: rgba(255,255,255,0.06);
            color: #b0b8d0;
            border: 1px solid rgba(255,255,255,0.10);
            box-shadow: 0 2px 8px rgba(0,0,0,0.2);
            backdrop-filter: blur(6px);
            transition: all .3s;
        }
        .btn-glass:hover {
            background: rgba(255,255,255,0.12);
            color: #fff;
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(0,0,0,0.3);
        }
        .glass-card {
            background: rgba(255,255,255,0.04);
            border: 1px solid rgba(255,255,255,0.08);
            border-radius: 20px;
            padding: 24px 28px;
            backdrop-filter: blur(8px);
        }
        .legend {
            display: flex;
            gap: 20px;
            margin-bottom: 20px;
            flex-wrap: wrap;
        }
        .legend-item {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 13px;
            color: #7880a0;
            font-weight: 500;
        }
        .legend-dot {
            width: 10px; height: 10px;
            border-radius: 50%;
        }
        .legend-dot.green { background: #2b9e4a; }
        .legend-dot.orange { background: #e6a020; }
        .legend-dot.red { background: #d14545; }

        :root {
            --fc-border-color: rgba(255,255,255,0.10);
            --fc-button-bg-color: rgba(255,255,255,0.06);
            --fc-button-border-color: rgba(255,255,255,0.10);
            --fc-button-hover-bg-color: rgba(255,255,255,0.12);
            --fc-button-hover-border-color: rgba(255,255,255,0.18);
            --fc-button-active-bg-color: rgba(77,150,255,0.20);
            --fc-button-text-color: #b0b8d0;
            --fc-page-bg-color: transparent;
            --fc-neutral-bg-color: rgba(255,255,255,0.03);
            --fc-neutral-text-color: #7880a0;
            --fc-today-bg-color: rgba(77,150,255,0.10);
        }
        .fc { color: #b0b8d0; }
        .fc-toolbar-title { font-weight: 700; font-size: 20px !important; color: #e0e4f0; }
        .fc-button { font-weight: 600 !important; border-radius: 10px !important; backdrop-filter: blur(6px); }
        .fc-button:hover { color: #fff !important; }
        .fc-button-primary:not(:disabled).fc-button-active { background: rgba(77,150,255,0.25) !important; border-color: #4d96ff !important; color: #7ab8ff !important; }
        .fc-daygrid-day-number { color: #b0b8d0; font-weight: 500; }
        .fc-daygrid-day.fc-day-today { background: rgba(77,150,255,0.10) !important; }
        .fc-daygrid-day.fc-day-other .fc-daygrid-day-number { color: #4a5080; }
        .fc-theme-standard td, .fc-theme-standard th { border-color: rgba(255,255,255,0.08); }
        .fc-theme-standard .fc-scrollgrid { border-color: rgba(255,255,255,0.08); border-radius: 12px; overflow: hidden; }
        .fc-daygrid-more-link { color: #7ab8ff !important; font-weight: 600; }
        .fc-event { border-radius: 6px !important; border: none !important; padding: 2px 4px !important; font-size: 12px !important; font-weight: 500 !important; }

        @media (max-width: 768px) {
            .container-custom { padding: 16px 16px 40px; }
            .top-bar { flex-direction: column; gap: 12px; align-items: flex-start; }
            .top-bar h2 { font-size: 22px; }
            .glass-card { padding: 12px; border-radius: 14px; }
            .fc-toolbar { flex-direction: column; gap: 8px; }
            .fc-toolbar-title { font-size: 16px !important; }
        }
    </style>
</head>
<body>

<div class="container-custom">
    <div class="top-bar">
        <h2>My Calendar</h2>
        <a href="/student" class="btn-glass">Back to Dashboard</a>
    </div>

    <div class="glass-card">
        <div class="legend">
            <div class="legend-item"><span class="legend-dot green"></span>Submitted</div>
            <div class="legend-item"><span class="legend-dot orange"></span>Pending</div>
            <div class="legend-item"><span class="legend-dot red"></span>Late</div>
        </div>
        <div id="calendar"></div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.15/index.global.min.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function () {
    const assignments = <%- JSON.stringify(assignments) %>;
    
    const events = assignments.map(a => {
        let color = '#e6a020';
        if (a.status === 'Submitted') color = '#2b9e4a';
        else if (a.status === 'Late') color = '#d14545';
        
        return {
            title: a.title,
            start: a.dueDate,
            color: color
        };
    });

    const calendarEl = document.getElementById('calendar');
    const calendar = new FullCalendar.Calendar(calendarEl, {
        initialView: 'dayGridMonth',
        events: events,
        height: 'auto',
        aspectRatio: window.innerWidth < 768 ? 1 : 1.6
    });
    calendar.render();
});
</script>

</body>
</html>