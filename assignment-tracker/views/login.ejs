<!DOCTYPE html>
<html>
<head>
  <title>Login</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');
    * { margin:0; padding:0; box-sizing:border-box; }
    body {
      font-family: 'Inter', sans-serif;
      background: linear-gradient(135deg, #f0f4ff 0%, #e8ecf8 100%);
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow-x: hidden;
    }
    .login-wrap { width: 100%; padding: 20px; }
    .login-card {
      max-width: 420px;
      margin: 0 auto;
      background: #fff;
      border-radius: 24px;
      padding: 40px 36px;
      box-shadow: 0 10px 40px rgba(0,0,0,0.06), 0 2px 8px rgba(0,0,0,0.04);
    }
    .login-card h2 {
      font-weight: 800;
      font-size: 28px;
      text-align: center;
      margin-bottom: 8px;
      background: linear-gradient(135deg, #4d96ff, #6b5bff);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }
    .login-card .sub {
      text-align: center;
      color: #8a8fa8;
      font-size: 14px;
      margin-bottom: 30px;
      font-weight: 500;
    }
    .login-card label {
      color: #4a4e6b;
      font-weight: 600;
      font-size: 13px;
      margin-bottom: 6px;
    }
    .login-card .form-control {
      background: #f5f6fa;
      border: 1px solid #e2e4ed;
      border-radius: 12px;
      color: #1a1c2e;
      padding: 12px 16px;
      font-size: 15px;
      transition: all .3s;
    }
    .login-card .form-control:focus {
      box-shadow: 0 0 0 3px rgba(77,150,255,0.12);
      border-color: #4d96ff;
      background: #fff;
      color: #1a1c2e;
    }
    .login-card .form-control::placeholder { color: #b0b4c8; }
    .login-card .input-group .form-control { border-right: none; border-radius: 12px 0 0 12px; }
    .login-card .input-group .btn-outline-secondary {
      background: #f5f6fa;
      border: 1px solid #e2e4ed;
      border-left: none;
      border-radius: 0 12px 12px 0;
      color: #6b7094;
      font-weight: 600;
      font-size: 13px;
      padding: 12px 16px;
      transition: all .3s;
    }
    .login-card .input-group .btn-outline-secondary:hover {
      background: #eef0f5;
      color: #4a4e6b;
    }
    .login-btn {
      width: 100%;
      padding: 12px;
      border: none;
      border-radius: 12px;
      font-weight: 700;
      font-size: 16px;
      color: #fff;
      background: linear-gradient(135deg, #4d96ff, #6b5bff);
      transition: all .3s;
      cursor: pointer;
    }
    .login-btn:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 30px rgba(77,150,255,0.25);
    }
    .alert-custom {
      background: #fff0f0;
      border: 1px solid #ffd4d4;
      border-radius: 12px;
      color: #d14545;
      padding: 12px 16px;
      font-size: 14px;
      font-weight: 500;
      margin-bottom: 20px;
      text-align: center;
    }
    .home-link {
      display: block;
      text-align: center;
      margin-top: 20px;
      color: #8a8fa8;
      text-decoration: none;
      font-size: 14px;
      font-weight: 500;
      transition: color .3s;
    }
    .home-link:hover { color: #4a4e6b; }

    @media (max-width: 480px) {
      .login-card { padding: 28px 20px; border-radius: 18px; }
      .login-card h2 { font-size: 24px; }
    }
  </style>
</head>
<body>
  <div class="login-wrap">
    <div class="login-card">
      <h2>Welcome</h2>
      <p class="sub">Sign in to your account</p>

      <% if(error){ %>
      <div class="alert-custom"><%= error %></div>
      <% } %>

      <form method="POST" action="/login">
        <div class="mb-3">
          <label>Username</label>
          <input type="text" name="username" class="form-control" placeholder="Enter your username" required>
        </div>
        <div class="mb-4">
          <label>Password</label>
          <div class="input-group">
            <input type="password" name="password" id="passwordInput" class="form-control" placeholder="Enter your password" required>
            <button class="btn btn-outline-secondary" type="button" id="togglePassword">Show</button>
          </div>
        </div>
        <button class="login-btn">Sign In</button>
      </form>
      <a href="/" class="home-link">&larr; Back to Home</a>
    </div>
  </div>
  <script>
    document.getElementById('togglePassword').addEventListener('click', function() {
      const input = document.getElementById('passwordInput');
      const btn = this;
      if (input.type === 'password') { input.type = 'text'; btn.textContent = 'Hide'; }
      else { input.type = 'password'; btn.textContent = 'Show'; }
    });
  </script>
</body>
</html>