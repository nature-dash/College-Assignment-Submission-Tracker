<!DOCTYPE html>
<html>
<head>
    <title>Admin Dashboard</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body{ background:#f4f7fc; }
        .card-box{ border:none; border-radius:20px; box-shadow:0px 5px 20px rgba(0,0,0,0.1); }
        .stat-card { text-decoration: none; color: inherit; display: block; }
        .stat-card:hover { transform: translateY(-5px); transition: 0.3s; }
    </style>
</head>
<body>

<div class="container mt-5">

    <div class="d-flex justify-content-between mb-4">
        <div>
            <h2>🛡️ Admin Dashboard</h2>
            <p>Welcome, <b><%= user.name || user.username %></b></p>
        </div>
        <div>
            <a href="/logout" class="btn btn-danger">Logout</a>
        </div>
    </div>

    <% const dashQuery = Object.keys(filters).filter(k => k !== 'taskStatus').map(k => k + '=' + encodeURIComponent(filters[k])).join('&'); %>

    <div class="row mb-4">
        <div class="col-md-3">
            <a href="/admin<%= dashQuery ? '?' + dashQuery : '' %>" class="stat-card">
                <div class="card card-box text-center p-4">
                    <h5>Total Tasks</h5>
                    <h1><%= totalTasks %></h1>
                </div>
            </a>
        </div>
        <div class="col-md-3">
            <a href="/admin?taskStatus=Submitted<%= dashQuery ? '&' + dashQuery : '' %>" class="stat-card">
                <div class="card card-box text-center p-4">
                    <h5>Submitted</h5>
                    <h1 class="text-success"><%= submittedCount %></h1>
                </div>
            </a>
        </div>
        <div class="col-md-3">
            <a href="/admin?taskStatus=Pending<%= dashQuery ? '&' + dashQuery : '' %>" class="stat-card">
                <div class="card card-box text-center p-4">
                    <h5>Pending</h5>
                    <h1 class="text-warning"><%= pendingCount %></h1>
                </div>
            </a>
        </div>
        <div class="col-md-3">
            <a href="/admin?taskStatus=Late<%= dashQuery ? '&' + dashQuery : '' %>" class="stat-card">
                <div class="card card-box text-center p-4">
                    <h5>Late</h5>
                    <h1 class="text-danger"><%= lateCount %></h1>
                </div>
            </a>
        </div>
    </div>

    <!-- Buttons above filters -->
    <div class="mb-4">
        <a href="/admin/config<%= dashQuery ? '?ref=' + encodeURIComponent(dashQuery) : '' %>" class="btn btn-warning me-2 text-white">⚙ Config</a>
        <a href="/admin/users<%= dashQuery ? '?ref=' + encodeURIComponent(dashQuery) : '' %>" class="btn btn-success me-2">👥 Manage Users</a>
        <a href="/admin/calendar<%= dashQuery ? '?ref=' + encodeURIComponent(dashQuery) : '' %>" class="btn btn-primary me-2">📅 Calendar</a>
    </div>

    <% if (!displayTasks) { %>

    <div class="card card-box p-4 mb-4">
        <h4 class="mb-3">Filters</h4>
        <form action="/admin" method="GET">
            <div class="row">
                <div class="col-md-4">
                    <select class="form-select" name="department">
                        <option>All Departments</option>
                        <option <%= filters.department === 'B.Sc Computer Science' ? 'selected' : '' %>>B.Sc Computer Science</option>
                        <option <%= filters.department === 'BCA' ? 'selected' : '' %>>BCA</option>
                        <option <%= filters.department === 'B.Com' ? 'selected' : '' %>>B.Com</option>
                        <option <%= filters.department === 'BBA' ? 'selected' : '' %>>BBA</option>
                        <option <%= filters.department === 'B.Sc Mathematics' ? 'selected' : '' %>>B.Sc Mathematics</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <select class="form-select" name="year">
                        <option>All Years</option>
                        <option value="1" <%= filters.year == '1' ? 'selected' : '' %>>I Year</option>
                        <option value="2" <%= filters.year == '2' ? 'selected' : '' %>>II Year</option>
                        <option value="3" <%= filters.year == '3' ? 'selected' : '' %>>III Year</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <select class="form-select" name="subject">
                        <option>All Subjects</option>
                        <option <%= filters.subject === 'DBMS' ? 'selected' : '' %>>DBMS</option>
                        <option <%= filters.subject === 'Java' ? 'selected' : '' %>>Java</option>
                        <option <%= filters.subject === 'Operating Systems' ? 'selected' : '' %>>Operating Systems</option>
                        <option <%= filters.subject === 'English' ? 'selected' : '' %>>English</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary w-100">Filter</button>
                </div>
            </div>
        </form>
    </div>

    <div class="card card-box p-4">
        <h4>All Assignments (Read-Only)</h4>
        <table class="table table-hover mt-3">
            <thead>
                <tr>
                    <th>Title</th>
                    <th>Assigned By</th>
                    <th>Department</th>
                    <th>Year</th>
                    <th>Subject</th>
                    <th>Due Date</th>
                    <th>Progress</th>
                </tr>
            </thead>
            <tbody>
                <% if(assignments.length === 0) { %>
                    <tr><td colspan="7" class="text-center text-muted">No assignments found</td></tr>
                <% } else { %>
                    <% assignments.forEach(function(a) { %>
                    <tr>
                        <td><a href="/admin/view/<%= a.id %><%= dashQuery ? '?ref=' + encodeURIComponent(dashQuery) : '' %>"><%= a.title %></a></td>
                        <td><%= a.assignedBy || 'Admin' %></td>
                        <td><%= a.department %></td>
                        <td><%= a.year %></td>
                        <td><%= a.subject %></td>
                        <td><%= new Date(a.dueDate).toLocaleDateString() %></td>
                        <td>
                            <% if(a.totalStudents === 0) { %>
                                <span class="badge bg-secondary">No Students</span>
                            <% } else { %>
                                <span class="badge <%= a.submittedStudents === a.totalStudents ? 'bg-success' : (a.submittedStudents > 0 ? 'bg-warning' : 'bg-danger') %>">
                                    <%= a.submittedStudents %>/<%= a.totalStudents %> submitted
                                </span>
                            <% } %>
                        </td>
                    </tr>
                    <% }); %>
                <% } %>
            </tbody>
        </table>
    </div>

    <% } else { %>

    <div class="mb-4 d-flex justify-content-between align-items-center">
        <h4>Showing <%= filters.taskStatus %> Tasks (<%= displayTasks.length %>)</h4>
        <a href="/admin<%= dashQuery ? '?' + dashQuery : '' %>" class="btn btn-secondary">🔙 Back to Overview</a>
    </div>

    <div class="card card-box p-4 mb-4">
        <h4 class="mb-3">Filters</h4>
        <form action="/admin" method="GET">
            <input type="hidden" name="taskStatus" value="<%= filters.taskStatus %>">
            <div class="row">
                <div class="col-md-4">
                    <select class="form-select" name="department">
                        <option>All Departments</option>
                        <option <%= filters.department === 'B.Sc Computer Science' ? 'selected' : '' %>>B.Sc Computer Science</option>
                        <option <%= filters.department === 'BCA' ? 'selected' : '' %>>BCA</option>
                        <option <%= filters.department === 'B.Com' ? 'selected' : '' %>>B.Com</option>
                        <option <%= filters.department === 'BBA' ? 'selected' : '' %>>BBA</option>
                        <option <%= filters.department === 'B.Sc Mathematics' ? 'selected' : '' %>>B.Sc Mathematics</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <select class="form-select" name="year">
                        <option>All Years</option>
                        <option value="1" <%= filters.year == '1' ? 'selected' : '' %>>I Year</option>
                        <option value="2" <%= filters.year == '2' ? 'selected' : '' %>>II Year</option>
                        <option value="3" <%= filters.year == '3' ? 'selected' : '' %>>III Year</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <select class="form-select" name="subject">
                        <option>All Subjects</option>
                        <option <%= filters.subject === 'DBMS' ? 'selected' : '' %>>DBMS</option>
                        <option <%= filters.subject === 'Java' ? 'selected' : '' %>>Java</option>
                        <option <%= filters.subject === 'Operating Systems' ? 'selected' : '' %>>Operating Systems</option>
                        <option <%= filters.subject === 'English' ? 'selected' : '' %>>English</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary w-100">Filter</button>
                </div>
            </div>
        </form>
    </div>

    <div class="card card-box p-4">
        <table class="table table-hover mt-3">
            <thead>
                <tr>
                    <th>Student Name</th>
                    <th>Assignment Title</th>
                    <th>Department</th>
                    <th>Due Date</th>
                    <th>Status</th>
                    <th>Submission Link</th>
                </tr>
            </thead>
            <tbody>
                <% if(displayTasks.length === 0) { %>
                    <tr><td colspan="6" class="text-center text-muted">No tasks found for this status.</td></tr>
                <% } else { %>
                    <% displayTasks.forEach(function(t) { %>
                    <tr>
                        <td><%= t.student.name %> (<%= t.student.username %>)</td>
                        <td><a href="/admin/view/<%= t.assignment.id %>"><%= t.assignment.title %></a></td>
                        <td><%= t.assignment.department %></td>
                        <td><%= new Date(t.assignment.dueDate).toLocaleDateString() %></td>
                        <td>
                            <% if(t.status === 'Submitted') { %>
                                <span class="badge bg-success">Submitted</span>
                            <% } else if(t.status === 'Pending') { %>
                                <span class="badge bg-warning">Pending</span>
                            <% } else if(t.status === 'Late') { %>
                                <span class="badge bg-danger">Late</span>
                            <% } %>
                        </td>
                        <td>
                            <% if(t.submission && t.submission.link) { %>
                                <a href="<%= t.submission.link %>" target="_blank" class="btn btn-sm btn-info text-white">View Link</a>
                            <% } else { %>
                                -
                            <% } %>
                        </td>
                    </tr>
                    <% }); %>
                <% } %>
            </tbody>
        </table>
    </div>

    <% } %>

</div>

</body>
</html>
