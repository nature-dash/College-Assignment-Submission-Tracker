<!DOCTYPE html>
<html>
<head>
    <title>View Assignment</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body{ background:#f4f7fc; }
        .card-box{ border:none; border-radius:20px; box-shadow:0px 5px 20px rgba(0,0,0,0.1); }
    </style>
</head>
<body>

<div class="container mt-5">
    <div class="d-flex justify-content-between mb-4">
        <h2><%= assignment.title %></h2>
        <a href="<%= ref ? '/admin?' + ref : '/admin' %>" class="btn btn-secondary">Back to Dashboard</a>
    </div>

    <div class="card card-box p-4 mb-4">
        <h4>Details</h4>
        <p><strong>Subject:</strong> <%= assignment.subject %></p>
        <p><strong>Department:</strong> <%= assignment.department %></p>
        <p><strong>Degree Level:</strong> <%= assignment.level || 'UG' %></p>
        <p><strong>Year:</strong> <%= assignment.year %></p>
        <p><strong>Due Date:</strong> <%= new Date(assignment.dueDate).toLocaleDateString() %></p>
        <p><strong>Assigned By:</strong> <%= assignment.assignedBy || 'Admin' %></p>
    </div>

    <div class="card card-box p-4">
        <h4>Student Submissions</h4>

        <table class="table table-hover mt-3">
            <thead>
                <tr>
                    <th>Reg. Number</th>
                    <th>Name</th>
                    <th>Status</th>
                    <th>Submission Link</th>
                    <th>Submitted On</th>
                </tr>
            </thead>
            <tbody>
                <% if(studentSubmissions.length === 0) { %>
                    <tr><td colspan="5" class="text-center text-muted">No students assigned.</td></tr>
                <% } else { %>
                    <% studentSubmissions.forEach(function(item) {
                        const isPastDue = new Date() > new Date(assignment.dueDate);
                        let statusBadge = '';
                        if(item.submission) {
                            const submittedLate = new Date(item.submission.submittedAt) > new Date(assignment.dueDate);
                            statusBadge = `<span class="badge bg-success">Submitted ${submittedLate ? '(Late)' : ''}</span>`;
                        } else {
                            if(isPastDue) {
                                statusBadge = `<span class="badge bg-danger">Late</span>`;
                            } else {
                                statusBadge = `<span class="badge bg-warning">Pending</span>`;
                            }
                        }
                    %>
                    <tr>
                        <td><%= item.student.username %></td>
                        <td><%= item.student.name %></td>
                        <td><%- statusBadge %></td>
                        <td>
                            <% if(item.submission && item.submission.link) { %>
                                <a href="<%= item.submission.link %>" target="_blank" class="btn btn-sm btn-info text-white">View Link</a>
                            <% } else { %>
                                -
                            <% } %>
                        </td>
                        <td>
                            <%= item.submission ? new Date(item.submission.submittedAt).toLocaleString() : '-' %>
                        </td>
                    </tr>
                    <% }); %>
                <% } %>
            </tbody>
        </table>
    </div>
</div>

</body>
</html>
