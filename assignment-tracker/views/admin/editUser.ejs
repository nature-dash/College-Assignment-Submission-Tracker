<!DOCTYPE html>
<html>
<head>
    <title>Edit User</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body{ background:#f4f7fc; }
        .card-box{ border:none; border-radius:20px; box-shadow:0px 5px 20px rgba(0,0,0,0.1); }

        .site-footer { text-align:center; padding:16px 12px; margin-top:40px; font-size:13px; color:#8a8fa8; border-top:1px solid rgba(0,0,0,0.06); }
        @media (max-width:480px) { .site-footer { font-size:11px; padding:12px 8px; } }
    </style>
</head>
<body class="bg-light">

<div class="container mt-5">
    <div class="card card-box p-4 mx-auto" style="max-width: 600px;">
        <div class="d-flex justify-content-between mb-3">
            <h2>Edit User</h2>
            <a href="<%= ref ? '/admin/users?ref=' + encodeURIComponent(ref) : '/admin/users' %>" class="btn btn-secondary">Back</a>
        </div>

        <% if (error) { %>
            <div class="alert alert-danger"><%= error %></div>
        <% } %>

        <form method="POST" action="/admin/users/edit/<%= editUser.id %>">
            <input type="hidden" name="ref" value="<%= ref %>">
            <div class="mb-3">
                <label>Role</label>
                <input class="form-control" value="<%= editUser.role === 'teacher' ? 'Teacher' : 'Student' %>" disabled>
            </div>

            <div class="mb-3">
                <label>Username (ID / Registration Number)</label>
                <input class="form-control" name="username" value="<%= editUser.username %>" required>
            </div>

            <div class="mb-3">
                <label>Full Name</label>
                <input class="form-control" name="name" value="<%= editUser.name %>" required>
            </div>

            <div class="mb-3">
                <label>Password</label>
                <div class="input-group">
                    <input type="text" class="form-control" name="password" value="<%= editUser.password %>" required>
                </div>
            </div>

            <% if(editUser.role === 'student') { %>
            <div class="mb-3">
                <label>Degree Level</label>
                <select class="form-select mb-3" name="level" id="levelSelect">
                    <% config.levels.forEach(function(l) { %>
                        <option value="<%= l %>" <%= editUser.level === l ? 'selected' : '' %>><%= l %></option>
                    <% }); %>
                </select>

                <label>Semester</label>
                <select class="form-select mb-3" name="semester" id="semesterSelect">
                </select>

                <label>Department</label>
                <select class="form-select" name="department">
                    <% config.departments.forEach(function(d) { %>
                        <option <%= editUser.department === d ? 'selected' : '' %>><%= d %></option>
                    <% }); %>
                </select>
            </div>
            <% } %>

            <button class="btn btn-primary">Update User</button>
        </form>
    </div>
</div>

<script>
    function populateSemesters(level, selected) {
        const maxSem = level === 'PG' ? 4 : 6;
        const select = document.getElementById('semesterSelect');
        select.innerHTML = '';
        for (let i = 1; i <= maxSem; i++) {
            const opt = document.createElement('option');
            opt.value = i;
            opt.textContent = 'Semester ' + i;
            if (selected && i === selected) opt.selected = true;
            select.appendChild(opt);
        }
    }

    document.getElementById('levelSelect').addEventListener('change', function() {
        populateSemesters(this.value, null);
    });

    var currentLevel = '<%= editUser.level || "UG" %>';
    var currentSem = <%= editUser.semester || 1 %>;
    populateSemesters(currentLevel, currentSem);
</script>

<footer class="site-footer">&copy; 2026 &#9670; Prince Shri Venkateshwara Arts and Science College &#9670; All rights reserved.</footer>
</body>
</html>
