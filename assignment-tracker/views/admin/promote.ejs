<!DOCTYPE html>
<html>
<head>
    <title>Student Promotion</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body{ background:#f4f7fc; }
        .card-box{ border:none; border-radius:20px; box-shadow:0px 5px 20px rgba(0,0,0,0.1); }

        .site-footer { text-align:center; padding:16px 12px; margin-top:40px; font-size:13px; color:#8a8fa8; border-top:1px solid rgba(0,0,0,0.06); }
        @media (max-width:480px) { .site-footer { font-size:11px; padding:12px 8px; } }
    </style>
</head>
<body>

<div class="container mt-5 mb-5">
    <div class="d-flex justify-content-between mb-4">
        <h2>Student Promotion</h2>
        <div>
            <a href="<%= ref ? '/admin?' + ref : '/admin' %>" class="btn btn-secondary me-2">Back to Dashboard</a>
            <a href="/admin/passedout<%= ref ? '?ref=' + encodeURIComponent(ref) : '' %>" class="btn btn-secondary">Passed Out Students</a>
        </div>
    </div>

    <% if (success) { %>
        <div class="alert alert-success">Promotion executed successfully!</div>
    <% } %>

    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card card-box text-center p-3">
                <h5>Active Students</h5>
                <h2><%= totalCount %></h2>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card card-box text-center p-3">
                <h5>Passed Out</h5>
                <h2><%= passedOutCount %></h2>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card card-box text-center p-3">
                <h5>To Be Promoted</h5>
                <h2 class="text-primary"><%= promoteCount %></h2>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card card-box text-center p-3">
                <h5>To Be Passed Out</h5>
                <h2 class="text-danger"><%= passOutCount %></h2>
            </div>
        </div>
    </div>

    <div class="card card-box p-4 mb-4">
        <h4 class="mb-3">Select Criteria</h4>
        <form action="/admin/promote" method="GET" class="row g-3">
            <% if(ref) { %><input type="hidden" name="ref" value="<%= ref %>"><% } %>
            <div class="col-md-4">
                <label class="form-label">Degree Level</label>
                <select class="form-select" name="level">
                    <option value="">All Levels</option>
                    <% config.levels.forEach(function(l) { %>
                        <option value="<%= l %>" <%= level === l ? 'selected' : '' %>><%= l %></option>
                    <% }); %>
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label">Department</label>
                <select class="form-select" name="department">
                    <option value="All Departments">All Departments</option>
                    <% config.departments.forEach(function(d) { %>
                        <option <%= department === d ? 'selected' : '' %>><%= d %></option>
                    <% }); %>
                </select>
            </div>
            <div class="col-md-4 d-flex align-items-end">
                <button type="submit" class="btn btn-primary w-100">Preview</button>
            </div>
        </form>
    </div>

    <% if (Object.keys(preview).length > 0) { %>
    <div class="card card-box p-4 mb-4">
        <h4 class="mb-3">Promotion Preview</h4>
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>Action</th>
                    <th>Students Affected</th>
                </tr>
            </thead>
            <tbody>
                <% Object.keys(preview).sort().forEach(function(key) { %>
                <tr>
                    <td><%= key %></td>
                    <td><span class="badge bg-primary fs-6"><%= preview[key] %></span></td>
                </tr>
                <% }); %>
            </tbody>
        </table>
        <p class="text-muted">Total: <strong><%= totalCount %></strong> students affected</p>

        <form action="/admin/promote" method="POST" onsubmit="return confirm('This will permanently promote <%= totalCount %> students. Are you sure?');">
            <input type="hidden" name="level" value="<%= level %>">
            <input type="hidden" name="department" value="<%= department || 'All Departments' %>">
            <% if(ref) { %><input type="hidden" name="ref" value="<%= ref %>"><% } %>
            <button type="submit" class="btn btn-warning text-white">Execute Promotion</button>
        </form>
    </div>
    <% } %>

    <div class="card card-box p-4">
        <h4 class="mb-3">Promotion Rules</h4>
        <ul>
            <% config.levels.forEach(function(l) { %>
                <% const years = config.years.filter(y => y.level === l).sort((a,b) => a.year - b.year); %>
                <% if (years.length > 0) { %>
                    <% const totalSemesters = years.reduce((sum, y) => sum + (y.semesters || 2), 0); %>
                    <% const yearLabels = years.map(y => `Year ${y.year} (${y.semesters || 2} Sem)`).join(' → '); %>
                    <li><strong><%= l %></strong> (<%= years.length %> Years, <%= totalSemesters %> Semesters): <%= yearLabels %> → Passed Out</li>
                <% } %>
            <% }); %>
            <li>Each promotion click advances the student by one semester.</li>
            <li>When a student completes the final semester of their current year, they advance to the next year (or pass out if in the final year).</li>
            <li>Passed out students are moved to a separate archive with the current year recorded as their pass-out year.</li>
            <li>Teachers will only see active (non-passed-out) students.</li>
            <li>This action <strong>cannot be undone</strong> automatically.</li>
        </ul>
    </div>
</div>

<footer class="site-footer">&copy; 2026 &#9670; Prince Shri Venkateshwara Arts and Science College &#9670; All rights reserved.</footer>
</body>
</html>
