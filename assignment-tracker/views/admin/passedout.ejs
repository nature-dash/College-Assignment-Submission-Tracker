<!DOCTYPE html>
<html>
<head>
    <title>Passed Out Students</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body{ background:#f4f7fc; }
        .card-box{ border:none; border-radius:20px; box-shadow:0px 5px 20px rgba(0,0,0,0.1); }
    </style>
</head>
<body class="bg-light">

<div class="container mt-5">
    <div class="card card-box p-4">
        <div class="d-flex justify-content-between mb-3">
            <h2> Passed Out Students</h2>
            <div>
                <a href="<%= ref ? '/admin?ref=' + encodeURIComponent(ref) : '/admin' %>" class="btn btn-secondary me-2"> Back to Dashboard</a>
                <a href="/admin/users<%= ref ? '?ref=' + encodeURIComponent(ref) : '' %>" class="btn btn-secondary"> Manage Users</a>
            </div>
        </div>

        <% if (!passedOut || passedOut.length === 0) { %>
            <div class="alert alert-info">No students have been passed out yet.</div>
        <% } else { %>
            <p class="text-muted">Showing <b><%= passedOut.length %></b> passed out student(s)</p>

            <table class="table table-bordered table-striped">
                <thead class="table-dark">
                    <tr>
                        <th>#</th>
                        <th>Username</th>
                        <th>Name</th>
                        <th>Department</th>
                        <th>Level</th>
                        <th>Year</th>
                        <th>Passed Out Year</th>
                    </tr>
                </thead>
                <tbody>
                    <% passedOut.forEach(function(s, i) { %>
                        <tr>
                            <td><%= i + 1 %></td>
                            <td><%= s.username %></td>
                            <td><%= s.name %></td>
                            <td><%= s.department %></td>
                            <td><%= s.level || 'UG' %></td>
                            <td><%= s.year %></td>
                            <td><%= s.passedOutYear %></td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>
        <% } %>
    </div>
</div>

</body>
</html>