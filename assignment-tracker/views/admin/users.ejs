<!DOCTYPE html>
<html>
<head>
    <title>User Management</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body{ background:#f4f7fc; }
        .card-box{ border:none; border-radius:20px; box-shadow:0px 5px 20px rgba(0,0,0,0.1); }
    </style>
</head>
<body>

<div class="container mt-5">
    <div class="d-flex justify-content-between mb-4">
        <h2>👥 User Management</h2>
        <div>
            <a href="<%= ref ? '/admin?' + ref : '/admin' %>" class="btn btn-secondary me-2">🔙 Back to Dashboard</a>
            <a href="/admin/users/add<%= ref ? '?ref=' + encodeURIComponent(ref) : '' %>" class="btn btn-success">➕ Add User</a>
            <a href="/admin/users/download<%= Object.keys(filters).length > 0 ? '?' + Object.entries(filters).filter(([k,v]) => k !== 'ref' && v).map(([k,v]) => k + '=' + encodeURIComponent(v)).join('&') : '' %>" class="btn btn-primary">📥 Download Excel</a>
            <a href="/admin/passedout<%= ref ? '?ref=' + encodeURIComponent(ref) : '' %>" class="btn btn-secondary">🎓 Passed Out</a>
        </div>
    </div>

    <% const config = (function(){ try { return JSON.parse(require('fs').readFileSync('./data/config.json')); } catch(e) { return {levels:['UG','PG'], departments:[], years:[]}; } })(); %>

    <div class="card card-box p-4 mb-4">
        <h4 class="mb-3">Filters</h4>
        <form action="/admin/users" method="GET">
            <% Object.keys(filters).forEach(function(key) { %>
                <% if (key !== 'role' && key !== 'level' && key !== 'department') { %>
                    <input type="hidden" name="<%= key %>" value="<%= filters[key] %>">
                <% } %>
            <% }); %>
            <div class="row">
                <div class="col-md-3">
                    <select class="form-select" name="role">
                        <option>All Roles</option>
                        <option <%= filters.role === 'student' ? 'selected' : '' %> value="student">Student</option>
                        <option <%= filters.role === 'teacher' ? 'selected' : '' %> value="teacher">Teacher</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <select class="form-select" name="level">
                        <option>All Levels</option>
                        <% config.levels.forEach(function(l) { %>
                            <option value="<%= l %>" <%= filters.level === l ? 'selected' : '' %>><%= l %></option>
                        <% }); %>
                    </select>
                </div>
                <div class="col-md-3">
                    <select class="form-select" name="department">
                        <option>All Departments</option>
                        <% config.departments.forEach(function(d) { %>
                            <option <%= filters.department === d ? 'selected' : '' %>><%= d %></option>
                        <% }); %>
                    </select>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary w-100">Filter</button>
                </div>
            </div>
        </form>
    </div>

    <div class="card card-box p-4">
        <p class="text-muted mb-2">Showing <%= users.length %> user(s)</p>
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>Username</th>
                    <th>Name</th>
                    <th>Role</th>
                    <th>Password</th>
                    <th>Level</th>
                    <th>Department</th>
                    <th>Year</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                <% if(users.length === 0) { %>
                    <tr><td colspan="8" class="text-center text-muted">No users found</td></tr>
                <% } else { %>
                    <% users.forEach(function(u) { %>
                    <tr>
                        <td><%= u.username %></td>
                        <td><%= u.name %></td>
                        <td>
                            <% if(u.role === 'teacher') { %>
                                <span class="badge bg-primary">Teacher</span>
                            <% } else { %>
                                <span class="badge bg-info">Student</span>
                            <% } %>
                        </td>
                        <td>
                            <span class="password-hidden" id="pw-<%= u.id %>">••••••</span>
                            <span class="password-shown d-none" id="pw-show-<%= u.id %>"><%= u.password %></span>
                            <button class="btn btn-sm btn-outline-secondary ms-1" onclick="togglePw(<%= u.id %>)">👁️</button>
                        </td>
                        <td><%= u.level || (u.role === 'student' ? 'UG' : '-') %></td>
                        <td><%= u.department || '-' %></td>
                        <td><%= u.year || '-' %></td>
                        <td>
                            <a href="/admin/users/edit/<%= u.id %><%= ref ? '?ref=' + encodeURIComponent(ref) : '' %>" class="btn btn-sm btn-primary">Edit</a>
                            <form action="/admin/users/remove/<%= u.id %>" method="POST" style="display:inline;">
                                <button class="btn btn-sm btn-danger" onclick="return confirm('Remove this user?');">Remove</button>
                            </form>
                        </td>
                    </tr>
                    <% }); %>
                <% } %>
            </tbody>
        </table>
    </div>
</div>

<script>
function togglePw(id) {
    const hidden = document.getElementById('pw-' + id);
    const shown = document.getElementById('pw-show-' + id);
    hidden.classList.toggle('d-none');
    shown.classList.toggle('d-none');
}
</script>

</body>
</html>
